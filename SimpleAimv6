-- ============ UTILS ============
local Utils = {}

function Utils.isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

function Utils.getVelocity(char)
    if not char then return Vector3.zero end
    local root = char:FindFirstChild("HumanoidRootPart")
    return (root and root:IsA("BasePart")) and root.AssemblyLinearVelocity or Vector3.zero
end

function Utils.checkWall(origin, target, ignoreChar)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    local result = workspace:Raycast(origin, target - origin, params)
    if result then
        return result.Instance:FindFirstAncestorOfClass("Model") == ignoreChar
    end
    return true
end

function Utils.isScoped()
    -- Verifica se o jogador está com scope (zoom)
    return Camera.FieldOfView < 50
end

function Utils.shouldFire()
    -- Legit: chance de gravar baseada no HitChance
    if not Config.LegitMode then return true end
    State.HitCounter = State.HitCounter + 1
    local threshold = math.floor(100 / math.max(Config.HitChance, 1))
    return State.HitCounter % threshold == 0
end

-- ============ AIMBOT ============
local Aimbot = {}

function Aimbot.getTarget()
    local closest, closestDist = nil, Config.FOVSize
    local center = Camera.ViewportSize / 2

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char or not Utils.isAlive(char) then continue end

        local part = char:FindFirstChild(Config.TargetPart)
            or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local targetPos = part.Position
        if Config.Prediction then
            targetPos += Utils.getVelocity(char) * Config.PredictFactor
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist >= closestDist then continue end

        if Config.WallCheck then
            if not Utils.checkWall(Camera.CFrame.Position, targetPos, char) then continue end
        end

        closest     = {part = part, char = char, player = player, pos = targetPos}
        closestDist = dist
    end

    return closest
end

function Aimbot.update()
    if not Config.AimbotEnabled then
        State.CurrentTarget = nil
        State.LockedOn      = false
        return
    end

    if Config.ScopeOnly and not Utils.isScoped() then return end
    if not Utils.shouldFire() then return end

    local target = Aimbot.getTarget()
    State.CurrentTarget = target
    State.LockedOn      = target ~= nil

    if target then
        local goalCF = CFrame.new(Camera.CFrame.Position, target.pos)
        Camera.CFrame = Camera.CFrame:Lerp(goalCF, 1 - Config.Smoothing)
    end
end

-- ============ FOV CIRCLE ============
local FOV = {}

function FOV.create()
    FOV.destroy()

    local frame = Instance.new("Frame")
    frame.Name                   = "FOV"
    frame.Size                   = UDim2.new(0, Config.FOVSize * 2, 0, Config.FOVSize * 2)
    frame.Position               = UDim2.new(0.5, -Config.FOVSize, 0.5, -Config.FOVSize)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel        = 0
    frame.ZIndex                 = 10
    frame.Parent                 = GUI.Screen

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1, 0, 1, 0)
    inner.BackgroundTransparency = 1
    inner.BorderSizePixel        = 0
    inner.Parent                 = frame
    Instance.new("UICorner", inner).CornerRadius = UDim.new(1, 0)

    local stroke = Instance.new("UIStroke")
    stroke.Color       = Config.FOVColor
    stroke.Thickness   = 1.5
    stroke.Transparency = Config.FOVTransparency
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent      = inner

    State.FOVCircle = frame
    State.FOVStroke = stroke
    State.FOVInner  = inner

    RunService:BindToRenderStep("FOVPulse", 200, function()
        if not State.FOVCircle then return end
        FOV.resize()
        if State.LockedOn then
            local t = math.abs(math.sin(tick() * 3))
            State.FOVStroke.Transparency = Config.FOVTransparency * 0.5 + t * 0.3
            State.FOVStroke.Thickness    = 2
        else
            State.FOVStroke.Color        = Config.FOVColor
            State.FOVStroke.Transparency = Config.FOVTransparency
            State.FOVStroke.Thickness    = 1.5
        end
    end)
end

function FOV.resize()
    if not State.FOVCircle then return end
    State.FOVCircle.Size     = UDim2.new(0, Config.FOVSize * 2, 0, Config.FOVSize * 2)
    State.FOVCircle.Position = UDim2.new(0.5, -Config.FOVSize, 0.5, -Config.FOVSize)
end

function FOV.destroy()
    RunService:UnbindFromRenderStep("FOVPulse")
    if State.FOVCircle then State.FOVCircle:Destroy(); State.FOVCircle = nil end
end

