local SG -- declarado antes

local function makeFOV()
    if ST.FOVFrame then ST.FOVFrame:Destroy() end
    local s  = CFG.FOV * 2
    local fr = Instance.new("Frame")
    fr.Name                   = "_FOV"
    fr.Size                   = UDim2.new(0, s, 0, s)
    fr.Position               = UDim2.new(0.5, -s/2, 0.5, -s/2)
    fr.BackgroundTransparency = 1
    fr.BorderSizePixel        = 0
    fr.ZIndex                 = 20
    fr.Parent                 = SG

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1,0,1,0)
    inner.BackgroundTransparency = 1
    inner.BorderSizePixel        = 0
    inner.Parent                 = fr
    Instance.new("UICorner", inner).CornerRadius = UDim.new(1,0)

    local st = Instance.new("UIStroke")
    st.Color           = CFG.FOVColor
    st.Thickness       = 1.2
    st.Transparency    = CFG.FOVAlpha
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent          = inner

    ST.FOVFrame  = fr
    ST.FOVStroke = st
end

local function removeFOV()
    if ST.FOVFrame then ST.FOVFrame:Destroy(); ST.FOVFrame = nil end
end

local function updateFOVSize()
    if not ST.FOVFrame then return end
    local s = CFG.FOV * 2
    ST.FOVFrame.Size     = UDim2.new(0, s, 0, s)
    ST.FOVFrame.Position = UDim2.new(0.5, -s/2, 0.5, -s/2)
end

-- ══════════════════════════════════════
--  ESP
-- ══════════════════════════════════════
local BONES = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"LowerTorso","LeftUpperLeg"},{"LowerTorso","RightUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"},{"RightUpperLeg","RightLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},{"RightLowerLeg","RightFoot"},
    {"UpperTorso","LeftUpperArm"},{"UpperTorso","RightUpperArm"},
    {"LeftUpperArm","LeftLowerArm"},{"RightUpperArm","RightLowerArm"},
    {"LeftLowerArm","LeftHand"},{"RightLowerArm","RightHand"},
}

local ESP = {}

function ESP.remove(p)
    local d = ST.ESPData[p]
    if not d then return end
    pcall(function()
        if d.hl  then d.hl:Destroy()  end
        if d.bb  then d.bb:Destroy()  end
        if d.box then d.box:Destroy() end
        if d.hbf then d.hbf:Destroy() end
        if d.trc then d.trc:Destroy() end
        for _, b in ipairs(d.bones or {}) do b.line:Destroy() end
    end)
    ST.ESPData[p] = nil
end

function ESP.add(p)
    ESP.remove(p)

    local function build(char)
        if not char then return end
        task.wait(0.3)
        if not char.Parent then return end
        if ST.ESPData[p] then ESP.remove(p) end

        local d = {bones = {}}
        ST.ESPData[p] = d

        -- Highlight
        local hl = Instance.new("Highlight")
        hl.FillTransparency    = 0.80
        hl.OutlineTransparency = 0.10
        hl.OutlineColor        = CFG.C_ACCENT
        hl.FillColor           = CFG.C_ACCENT
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled             = CFG.ChamsOn
        hl.Parent              = char
        d.hl                   = hl

        -- Billboard
        local head = char:FindFirstChild("Head")
        if head then
            local bb = Instance.new("BillboardGui")
            bb.Size         = UDim2.new(0,120,0,36)
            bb.StudsOffset  = Vector3.new(0,2.8,0)
            bb.AlwaysOnTop  = true
            bb.Parent       = head
            d.bb            = bb

            local nl = Instance.new("TextLabel")
            nl.Name                   = "NL"
            nl.Size                   = UDim2.new(1,0,0.55,0)
            nl.BackgroundTransparency = 1
            nl.Text                   = p.Name
            nl.TextColor3             = Color3.fromRGB(255,255,255)
            nl.TextStrokeTransparency = 0.3
            nl.Font                   = Enum.Font.GothamBold
            nl.TextSize               = 12
            nl.Visible                = CFG.NameOn
            nl.Parent                 = bb

            local dl = Instance.new("TextLabel")
            dl.Name                   = "DL"
            dl.Size                   = UDim2.new(1,0,0.45,0)
            dl.Position               = UDim2.new(0,0,0.55,0)
            dl.BackgroundTransparency = 1
            dl.Text                   = ""
            dl.TextColor3             = CFG.C_ACCENT
            dl.TextStrokeTransparency = 0.3
            dl.Font                   = Enum.Font.Gotham
            dl.TextSize               = 10
            dl.Visible                = CFG.DistOn
            dl.Parent                 = bb
        end

        -- Box
        local boxF = Instance.new("Frame")
        boxF.BackgroundTransparency = 1
        boxF.BorderSizePixel        = 0
        boxF.ZIndex                 = 10
        boxF.Visible                = false
        boxF.Parent                 = SG
        d.box      = boxF
        d.boxSides = {}
        for i = 1,4 do
            local s = Instance.new("Frame")
            s.BackgroundColor3 = CFG.C_ACCENT
            s.BorderSizePixel  = 0
            s.ZIndex           = 10
            s.Parent           = boxF
            d.boxSides[i]      = s
        end

        -- Health bar
        local hbf = Instance.new("Frame")
        hbf.BackgroundColor3       = Color3.fromRGB(20,20,20)
        hbf.BackgroundTransparency = 0.3
        hbf.BorderSizePixel        = 0
        hbf.ZIndex                 = 11
        hbf.Visible                = false
        hbf.Parent                 = SG
        d.hbf                      = hbf

        local hbFill = Instance.new("Frame")
        hbFill.BackgroundColor3 = CFG.C_GREEN
        hbFill.BorderSizePixel  = 0
        hbFill.ZIndex           = 12
        hbFill.Parent           = hbf
        d.hbFill                = hbFill

        -- Tracer
        local trc = Instance.new("Frame")
        trc.BackgroundColor3       = CFG.C_ACCENT
        trc.BackgroundTransparency = 0.3
        trc.BorderSizePixel        = 0
        trc.AnchorPoint            = Vector2.new(0.5,0)
        trc.ZIndex                 = 9
        trc.Visible                = false
        trc.Parent                 = SG
        d.trc                      = trc

        -- Skeleton
        for _, bone in ipairs(BONES) do
            local l = Instance.new("Frame")
            l.BackgroundColor3 = CFG.C_ACCENT
            l.BorderSizePixel  = 0
            l.AnchorPoint      = Vector2.new(0.5,0)
            l.ZIndex           = 8
            l.Visible          = false
            l.Parent           = SG
            table.insert(d.bones, {line=l, b1=bone[1], b2=bone[2]})
        end

        -- Loop
        task.spawn(function()
            while ST.ESPData[p] == d and char.Parent and CFG.ESPOn do
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local myR  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not root or not hum then task.wait(0.05); continue end

                local col = CFG.C_ACCENT
                if ST.Target and ST.Target.player == p then col = CFG.C_GREEN end
                if hum.Health <= 0 then col = CFG.C_RED end

                d.hl.Enabled      = CFG.ChamsOn
                d.hl.OutlineColor = col
                d.hl.FillColor    = col

                if d.bb then
                    local nl = d.bb:FindFirstChild("NL")
                    local dl = d.bb:FindFirstChild("DL")
                    if nl then nl.Visible = CFG.NameOn end
                    if dl then
                        dl.Visible = CFG.DistOn
                        if CFG.DistOn and myR then
                            dl.Text = math.floor((root.Position - myR.Position).Magnitude).."m"
                        end
                    end
                end

                -- Bounding box
                local pts = {"Head","UpperTorso","LowerTorso","LeftHand","RightHand","LeftFoot","RightFoot"}
                local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
                local allOn = true
                for _, pn in ipairs(pts) do
                    local pp = char:FindFirstChild(pn)
                    if pp then
                        local sp2, on2 = CAM:WorldToViewportPoint(pp.Position)
                        if not on2 then allOn=false; break end
                        if sp2.X < minX then minX=sp2.X end
                        if sp2.Y < minY then minY=sp2.Y end
                        if sp2.X > maxX then maxX=sp2.X end
                        if sp2.Y > maxY then maxY=sp2.Y end
                    end
                end

                -- Box
                d.box.Visible = CFG.BoxOn and allOn
                if CFG.BoxOn and allOn then
                    local pad,t2 = 4,1.5
                    local bx,by = minX-pad, minY-pad
                    local bw,bh = (maxX-minX)+pad*2, (maxY-minY)+pad*2
                    d.box.Position = UDim2.new(0,bx,0,by)
                    d.box.Size     = UDim2.new(0,bw,0,bh)
                    d.boxSides[1].Position=UDim2.new(0,0,0,0);    d.boxSides[1].Size=UDim2.new(1,0,0,t2); d.boxSides[1].BackgroundColor3=col
                    d.boxSides[2].Position=UDim2.new(0,0,1,-t2);  d.boxSides[2].Size=UDim2.new(1,0,0,t2); d.boxSides[2].BackgroundColor3=col
                    d.boxSides[3].Position=UDim2.new(0,0,0,0);    d.boxSides[3].Size=UDim2.new(0,t2,1,0); d.boxSides[3].BackgroundColor3=col
                    d.boxSides[4].Position=UDim2.new(1,-t2,0,0);  d.boxSides[4].Size=UDim2.new(0,t2,1,0); d.boxSides[4].BackgroundColor3=col
                end

                -- Health
                d.hbf.Visible = CFG.HealthOn and allOn
                if CFG.HealthOn and allOn then
                    local hp = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                    d.hbf.Position  = UDim2.new(0,minX-6,0,minY)
                    d.hbf.Size      = UDim2.new(0,4,0,maxY-minY)
                    d.hbFill.Size   = UDim2.new(1,0,hp,0)
                    d.hbFill.Position = UDim2.new(0,0,1-hp,0)
                    d.hbFill.BackgroundColor3 = Color3.fromHSV(hp*0.33,1,1)
                end

                -- Tracer
                d.trc.Visible = CFG.TracerOn
                if CFG.TracerOn then
                    local sp2,on2 = CAM:WorldToViewportPoint(root.Position)
                    if on2 then
                        local cx = CAM.ViewportSize.X/2
                        local cy = CAM.ViewportSize.Y
                        local dx = sp2.X-cx; local dy = sp2.Y-cy
                        local len= math.sqrt(dx*dx+dy*dy)
                        d.trc.Position = UDim2.new(0,cx,0,cy)
                        d.trc.Size     = UDim2.new(0,len,0,1)
                        d.trc.Rotation = math.deg(math.atan2(dy,dx))
                        d.trc.BackgroundColor3 = col
                    else
                        d.trc.Visible = false
                    end
                end

                -- Skeleton
                for _, bd in ipairs(d.bones) do
                    bd.line.Visible = CFG.SkeleOn
                    if CFG.SkeleOn then
                        local p1 = char:FindFirstChild(bd.b1)
                        local p2 = char:FindFirstChild(bd.b2)
                        if p1 and p2 then
                            local sp1,o1 = CAM:WorldToViewportPoint(p1.Position)
                            local sp2,o2 = CAM:WorldToViewportPoint(p2.Position)
                            if o1 and o2 then
                                local dx=sp2.X-sp1.X; local dy=sp2.Y-sp1.Y
                                local len=math.sqrt(dx*dx+dy*dy)
                                bd.line.Position = UDim2.new(0,sp1.X,0,sp1.Y)
                                bd.line.Size     = UDim2.new(0,len,0,1.5)
                                bd.line.Rotation = math.deg(math.atan2(dy,dx))
                                bd.line.BackgroundColor3 = col
                            else
                                bd.line.Visible = false
                            end
                        end
                    end
                end

                task.wait(0)
            end
            ESP.remove(p)
        end)
    end

    if p.Character then build(p.Character) end
    p.CharacterAdded:Connect(build)
end

function ESP.enable()
    ESP.disable()
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP then ESP.add(p) end
    end
    PL.PlayerAdded:Connect(function(p)
        if p ~= LP and CFG.ESPOn then ESP.add(p) end
    end)
    PL.PlayerRemoving:Connect(ESP.remove)
end

function ESP.disable()
    for p in pairs(ST.ESPData) do ESP.remove(p) end
end

