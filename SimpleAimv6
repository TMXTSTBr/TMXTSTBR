-- ══════════════════════════════════════
local function corner(obj, r)
    Instance.new("UICorner", obj).CornerRadius = r or UDim.new(0,6)
end

local function addStroke(obj, col, thick, alpha)
    local s = Instance.new("UIStroke")
    s.Color        = col   or CFG.C_BORDER
    s.Thickness    = thick or 1
    s.Transparency = alpha or 0.4
    s.Parent       = obj
    return s
end

local function tw(obj, props, t, style)
    TS:Create(obj, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quart), props):Play()
end

-- ──────────────────────────────────────
--  SWITCH (Touch-friendly)
-- ──────────────────────────────────────
local function mkSwitch(parent, cb)
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0,42,0,24)
    track.BackgroundColor3 = CFG.C_OFF
    track.BorderSizePixel  = 0
    track.Parent           = parent
    corner(track, UDim.new(1,0))

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0,18,0,18)
    thumb.Position         = UDim2.new(0,3,0.5,-9)
    thumb.BackgroundColor3 = Color3.fromRGB(120,120,140)
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    corner(thumb, UDim.new(1,0))

    local on = false
    local function set(v)
        on = v
        tw(track, {BackgroundColor3 = on and CFG.C_ON or CFG.C_OFF})
        tw(thumb, {
            Position         = on and UDim2.new(0,21,0.5,-9) or UDim2.new(0,3,0.5,-9),
            BackgroundColor3 = on and Color3.fromRGB(220,180,255) or Color3.fromRGB(120,120,140),
        })
        if cb then cb(on) end
    end

    -- Touch + Mouse
    local btn = Instance.new("TextButton")
    btn.Size                 = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text                 = ""
    btn.Parent               = track
    btn.MouseButton1Click:Connect(function() set(not on) end)

    return track, set
end

-- ──────────────────────────────────────
--  SLIDER com input numérico (Touch)
-- ──────────────────────────────────────
local function mkSlider(parent, lbl, min, max, default, order, cb)
    local wrap = Instance.new("Frame")
    wrap.Size             = UDim2.new(1,0,0,56)
    wrap.BackgroundColor3 = CFG.C_CARD
    wrap.BorderSizePixel  = 0
    wrap.LayoutOrder      = order
    wrap.Parent           = parent
    corner(wrap)

    -- Label
    local lblEl = Instance.new("TextLabel")
    lblEl.Size                = UDim2.new(1,-80,0,20)
    lblEl.Position            = UDim2.new(0,10,0,6)
    lblEl.BackgroundTransparency = 1
    lblEl.Text                = lbl
    lblEl.TextColor3          = CFG.C_TEXT
    lblEl.Font                = Enum.Font.GothamMedium
    lblEl.TextSize            = 11
    lblEl.TextXAlignment      = Enum.TextXAlignment.Left
    lblEl.Parent              = wrap

    -- Valor digitável
    local valBox = Instance.new("TextBox")
    valBox.Size              = UDim2.new(0,60,0,22)
    valBox.Position          = UDim2.new(1,-68,0,5)
    valBox.BackgroundColor3  = Color3.fromRGB(28,28,42)
    valBox.BorderSizePixel   = 0
    valBox.Text              = tostring(default)
    valBox.TextColor3        = CFG.C_ACCENT
    valBox.Font              = Enum.Font.GothamBold
    valBox.TextSize          = 12
    valBox.ClearTextOnFocus  = true
    valBox.Parent            = wrap
    corner(valBox, UDim.new(0,4))

    -- Track
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1,-20,0,6)
    track.Position         = UDim2.new(0,10,0,38)
    track.BackgroundColor3 = Color3.fromRGB(32,32,48)
    track.BorderSizePixel  = 0
    track.Parent           = wrap
    corner(track, UDim.new(1,0))

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = CFG.C_ACCENT
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    corner(fill, UDim.new(1,0))

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0,16,0,16)
    knob.Position         = UDim2.new((default-min)/(max-min),0,0.5,-8)
    knob.AnchorPoint      = Vector2.new(0.5,0.5)
    knob.BackgroundColor3 = Color3.fromRGB(180,100,255)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 3
    knob.Parent           = track
    corner(knob, UDim.new(1,0))

    local val  = default
    local drag = false

    local function updateVal(v)
        v   = math.clamp(math.floor(v), min, max)
        val = v
        local rel = (v-min)/(max-min)
        fill.Size     = UDim2.new(rel,0,1,0)
        knob.Position = UDim2.new(rel,0,0.5,-8)
        valBox.Text   = tostring(v)
        if cb then cb(v) end
    end

    local function fromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X,1), 0, 1)
        updateVal(min + rel*(max-min))
    end

    -- Touch input no track
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            fromX(i.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then
            fromX(i.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)

    valBox.FocusLost:Connect(function()
        local n = tonumber(valBox.Text)
        if n then updateVal(n) else valBox.Text = tostring(val) end
    end)

    return wrap
end

