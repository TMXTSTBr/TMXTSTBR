-- ============ COMPONENTES BASE ============
local C = {}

function C.frame(props)
    local f = Instance.new("Frame")
    for k, v in pairs(props) do
        if k ~= "parent" and k ~= "corner" then
            f[k] = v
        end
    end
    if props.corner then
        Instance.new("UICorner", f).CornerRadius = props.corner
    end
    if props.parent then f.Parent = props.parent end
    return f
end

function C.label(props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    for k, v in pairs(props) do
        if k ~= "parent" then l[k] = v end
    end
    if props.parent then l.Parent = props.parent end
    return l
end

function C.button(props)
    local b = Instance.new("TextButton")
    b.AutoButtonColor    = false
    b.BorderSizePixel    = 0
    for k, v in pairs(props) do
        if k ~= "parent" and k ~= "corner" then
            b[k] = v
        end
    end
    if props.corner then
        Instance.new("UICorner", b).CornerRadius = props.corner
    end
    if props.parent then b.Parent = props.parent end

    -- Hover
    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = 0.2}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {BackgroundTransparency = b.BackgroundTransparency < 0.2 and 0 or b.BackgroundTransparency}):Play()
    end)

    return b
end

function C.image(props)
    local i = Instance.new("ImageLabel")
    i.BackgroundTransparency = 1
    i.BorderSizePixel        = 0
    for k, v in pairs(props) do
        if k ~= "parent" and k ~= "corner" then i[k] = v end
    end
    if props.corner then
        Instance.new("UICorner", i).CornerRadius = props.corner
    end
    if props.parent then i.Parent = props.parent end
    return i
end

-- Switch (toggle)
function C.switch(parent, order, onCallback)
    local row = C.frame({
        Size = UDim2.new(0, 44, 0, 24),
        BackgroundColor3 = Color3.fromRGB(40, 40, 55),
        BorderSizePixel = 0,
        LayoutOrder = order,
        parent = parent,
        corner = UDim.new(1, 0),
    })

    local thumb = C.frame({
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(160, 160, 180),
        BorderSizePixel = 0,
        parent = row,
        corner = UDim.new(1, 0),
    })

    local enabled = false

    local function toggle(val)
        enabled = val
        local tgoal = enabled
            and {Position = UDim2.new(0, 23, 0.5, -9), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}
            or  {Position = UDim2.new(0, 3,  0.5, -9), BackgroundColor3 = Color3.fromRGB(160, 160, 180)}
        local rgoal = enabled
            and {BackgroundColor3 = Config.ColorAccent}
            or  {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}
        TweenService:Create(thumb, TweenInfo.new(0.18), tgoal):Play()
        TweenService:Create(row,   TweenInfo.new(0.18), rgoal):Play()
        if onCallback then onCallback(enabled) end
    end

    local btn = C.button({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        parent = row,
    })
    btn.MouseButton1Click:Connect(function() toggle(not enabled) end)

    return row, toggle
end

-- Slider
function C.slider(parent, label, min, max, default, order, callback)
    local row = C.frame({
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        LayoutOrder = order,
        parent = parent,
    })

    local lbl = C.label({
        Size = UDim2.new(1, 0, 0, 18),
        Text = label .. ": " .. default,
        TextColor3 = Color3.fromRGB(200, 200, 220),
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        parent = row,
    })

    local track = C.frame({
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(40, 40, 58),
        BorderSizePixel = 0,
        parent = row,
        corner = UDim.new(1, 0),
    })

    local fill = C.frame({
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Config.ColorAccent,
        BorderSizePixel = 0,
        parent = track,
        corner = UDim.new(1, 0),
    })

    local thumb = C.frame({
        Size = UDim2.new(0, 13, 0, 13),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(255, 200, 50),
        BorderSizePixel = 0,
        ZIndex = 3,
        parent = track,
        corner = UDim.new(1, 0),
    })

    local val = default
    local dragging = false

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        val = math.floor(min + rel * (max - min))
        fill.Size = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, 0, 0.5, 0)
        lbl.Text = label .. ": " .. val
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; update(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return row
end

