local ESP = {}

-- Bones para skeleton
local BONES = {
    {"Head",          "UpperTorso"},
    {"UpperTorso",    "LowerTorso"},
    {"LowerTorso",    "LeftUpperLeg"},
    {"LowerTorso",    "RightUpperLeg"},
    {"LeftUpperLeg",  "LeftLowerLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"LeftLowerLeg",  "LeftFoot"},
    {"RightLowerLeg", "RightFoot"},
    {"UpperTorso",    "LeftUpperArm"},
    {"UpperTorso",    "RightUpperArm"},
    {"LeftUpperArm",  "LeftLowerArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"LeftLowerArm",  "LeftHand"},
    {"RightLowerArm", "RightHand"},
}

function ESP.setupPlayer(player)
    if State.ESPObjects[player] then return end

    local obj = {
        highlight   = nil,
        billboard   = nil,
        box         = nil,
        skeleton    = {},
        healthBar   = nil,
        tracer      = nil,
        headDot     = nil,
    }
    State.ESPObjects[player] = obj

    local function build(char)
        if not char then return end
        task.wait(0.5)
        if not char.Parent then return end

        -- Highlight (wallhack base)
        if Config.ESPEnabled then
            local hl              = Instance.new("Highlight")
            hl.Name               = "ESPHighlight"
            hl.FillTransparency   = 0.8
            hl.OutlineTransparency = 0.1
            hl.OutlineColor       = Config.ColorAccent
            hl.FillColor          = Config.ColorAccent
            hl.DepthMode          = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent             = char
            obj.highlight         = hl
        end

        -- Billboard (nome + distância)
        local head = char:FindFirstChild("Head")
        if head and (Config.NameESP or Config.DistanceESP) then
            local bb              = Instance.new("BillboardGui")
            bb.Size               = UDim2.new(0, 110, 0, 45)
            bb.StudsOffset        = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop        = true
            bb.Parent             = head

            local nameLbl         = Instance.new("TextLabel")
            nameLbl.Name          = "NameLbl"
            nameLbl.Size          = UDim2.new(1, 0, 0.55, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text          = player.Name
            nameLbl.TextColor3    = Color3.fromRGB(255, 255, 255)
            nameLbl.TextStrokeTransparency = 0.4
            nameLbl.Font          = Enum.Font.GothamBold
            nameLbl.TextSize      = 12
            nameLbl.Visible       = Config.NameESP
            nameLbl.Parent        = bb

            local distLbl         = Instance.new("TextLabel")
            distLbl.Name          = "DistLbl"
            distLbl.Size          = UDim2.new(1, 0, 0.45, 0)
            distLbl.Position      = UDim2.new(0, 0, 0.55, 0)
            distLbl.BackgroundTransparency = 1
            distLbl.Text          = "-- m"
            distLbl.TextColor3    = Color3.fromRGB(255, 220, 100)
            distLbl.TextStrokeTransparency = 0.4
            distLbl.Font          = Enum.Font.Gotham
            distLbl.TextSize      = 10
            distLbl.Visible       = Config.DistanceESP
            distLbl.Parent        = bb

            obj.billboard = bb

            -- Head dot
            if Config.HeadDot then
                local dot         = Instance.new("Frame")
                dot.Size          = UDim2.new(0, 8, 0, 8)
                dot.AnchorPoint   = Vector2.new(0.5, 0.5)
                dot.Position      = UDim2.new(0.5, 0, 0, -5)
                dot.BackgroundColor3 = Config.ColorAccent
                dot.BorderSizePixel = 0
                dot.ZIndex        = 5
                Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
                dot.Parent        = bb
                obj.headDot       = dot
            end
        end

        -- Box ESP (2D)
        if Config.BoxESP then
            local boxFrame        = Instance.new("Frame")
            boxFrame.Name         = "BoxESP"
            boxFrame.BackgroundTransparency = 1
            boxFrame.BorderSizePixel = 0
            boxFrame.ZIndex       = 6
            boxFrame.Parent       = GUI.Screen

            -- 4 bordas do box
            local sides = {}
            for i = 1, 4 do
                local side        = Instance.new("Frame")
                side.BackgroundColor3 = Config.ColorAccent
                side.BorderSizePixel = 0
                side.ZIndex       = 6
                side.Parent       = boxFrame
                sides[i]          = side
            end
            obj.box               = {frame = boxFrame, sides = sides}
        end

        -- Skeleton ESP
        if Config.SkeletonESP then
            local skeletonLines = {}
            for _, bone in ipairs(BONES) do
                local line        = Instance.new("Frame")
                line.BackgroundColor3 = Config.ColorOn
                line.BorderSizePixel = 0
                line.AnchorPoint  = Vector2.new(0.5, 0)
                line.ZIndex       = 5
                line.Parent       = GUI.Screen
                skeletonLines[#skeletonLines + 1] = {line = line, bone = bone}
            end
            obj.skeleton          = skeletonLines
        end

        -- Tracer
        if Config.TracerESP then
            local tracer          = Instance.new("Frame")
            tracer.BackgroundColor3 = Config.ColorAccent
            tracer.BorderSizePixel = 0
            tracer.AnchorPoint    = Vector2.new(0.5, 0)
            tracer.ZIndex         = 4
            tracer.Parent         = GUI.Screen
            obj.tracer            = tracer
        end

        -- Health Bar
        if Config.HealthBar then
            local hbFrame         = Instance.new("Frame")
            hbFrame.Name          = "HealthBar"
            hbFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            hbFrame.BorderSizePixel = 0
            hbFrame.ZIndex        = 7
            hbFrame.Parent        = GUI.Screen

            local hbFill          = Instance.new("Frame")
            hbFill.Name           = "Fill"
            hbFill.BackgroundColor3 = Config.ColorOn
            hbFill.BorderSizePixel = 0
            hbFill.Size           = UDim2.new(1, 0, 1, 0)
            hbFill.Parent         = hbFrame

            obj.healthBar         = {frame = hbFrame, fill = hbFill}
        end

        -- Loop de atualização do ESP
        task.spawn(function()
            while State.ESPObjects[player] and char.Parent do
                ESP.updateChar(player, char)
                task.wait(0)
            end
            ESP.cleanObj(obj)
        end)
    end

    if player.Character then build(player.Character) end
    player.CharacterAdded:Connect(function(char)
        ESP.cleanObj(obj)
        build(char)
    end)
end

function ESP.updateChar(player, char)
    local obj = State.ESPObjects[player]
    if not obj then return end

    local root   = char:FindFirstChild("HumanoidRootPart")
    local hum    = char:FindFirstChildOfClass("Humanoid")
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root or not hum then return end

    -- Cor baseada no alvo travado
    local color = Config.ColorAccent
    if State.CurrentTarget and State.CurrentTarget.player == player then
        color = Config.ColorOn
    end
    if hum.Health <= 0 then color = Config.ColorOff end

    -- Highlight cor
    if obj.highlight then
        obj.highlight.OutlineColor = color
        obj.highlight.FillColor    = color
    end

    -- Distância
    if obj.billboard and myRoot then
        local dist = math.floor((root.Position - myRoot.Position).Magnitude)
        local dl   = obj.billboard:FindFirstChild("DistLbl")
        if dl then dl.Text = dist .. " m"; dl.Visible = Config.DistanceESP end
        local nl   = obj.billboard:FindFirstChild("NameLbl")
        if nl then nl.Visible = Config.NameESP end
    end

    -- BOX ESP 2D
    if obj.box then
        local parts   = {"Head", "UpperTorso", "LowerTorso", "LeftHand", "RightHand", "LeftFoot", "RightFoot"}
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        local allOnScreen = true

        for _, pname in ipairs(parts) do
            local p = char:FindFirstChild(pname)
            if p then
                local sp, on = Camera:WorldToViewportPoint(p.Position)
                if not on then allOnScreen = false; break end
                minX = math.min(minX, sp.X)
                minY = math.min(minY, sp.Y)
                maxX = math.max(maxX, sp.X)
                maxY = math.max(maxY, sp.Y)
            end
        end

        if allOnScreen then
            local pad = 4
            local bx, by = minX - pad, minY - pad
            local bw, bh = (maxX - minX) + pad * 2, (maxY - minY) + pad * 2
            local thick  = 1.5
            local sides  = obj.box.sides
            local frame  = obj.box.frame

            frame.Position = UDim2.new(0, bx, 0, by)
            frame.Size     = UDim2.new(0, bw, 0, bh)

            -- Top
            sides[1].Position = UDim2.new(0, 0, 0, 0)
            sides[1].Size     = UDim2.new(1, 0, 0, thick)
            sides[1].BackgroundColor3 = color
            -- Bottom
            sides[2].Position = UDim2.new(0, 0, 1, -thick)
            sides[2].Size     = UDim2.new(1, 0, 0, thick)
            sides[2].BackgroundColor3 = color
            -- Left
            sides[3].Position = UDim2.new(0, 0, 0, 0)
            sides[3].Size     = UDim2.new(0, thick, 1, 0)
            sides[3].BackgroundColor3 = color
            -- Right
            sides[4].Position = UDim2.new(1, -thick, 0, 0)
            sides[4].Size     = UDim2.new(0, thick, 1, 0)
            sides[4].BackgroundColor3 = color

            obj.box.frame.Visible = true
        else
            if obj.box.frame then obj.box.frame.Visible = false end
        end
    end

    -- SKELETON
    for _, sk in ipairs(obj.skeleton or {}) do
        local p1 = char:FindFirstChild(sk.bone[1])
        local p2 = char:FindFirstChild(sk.bone[2])
        if p1 and p2 then
            local sp1, on1 = Camera:WorldToViewportPoint(p1.Position)
            local sp2, on2 = Camera:WorldToViewportPoint(p2.Position)
            if on1 and on2 then
                local dx   = sp2.X - sp1.X
                local dy   = sp2.Y - sp1.Y
                local len  = math.sqrt(dx * dx + dy * dy)
                local angle = math.atan2(dy, dx)

                sk.line.Position = UDim2.new(0, sp1.X, 0, sp1.Y)
                sk.line.Size     = UDim2.new(0, len, 0, 1.5)
                sk.line.Rotation = math.deg(angle)
                sk.line.BackgroundColor3 = color
                sk.line.Visible  = true
            else
                sk.line.Visible = false
            end
        end
    end

    -- TRACER
    if obj.tracer then
        local sp, on = Camera:WorldToViewportPoint(root.Position)
        if on then
            local cx   = Camera.ViewportSize.X / 2
            local cy   = Camera.ViewportSize.Y
            local dx   = sp.X - cx
            local dy   = sp.Y - cy
            local len  = math.sqrt(dx * dx + dy * dy)
            local angle = math.atan2(dy, dx)

            obj.tracer.Position = UDim2.new(0, cx, 0, cy)
            obj.tracer.Size     = UDim2.new(0, len, 0, 1)
            obj.tracer.Rotation = math.deg(angle)
            obj.tracer.BackgroundColor3 = color
            obj.tracer.Visible  = true
        else
            obj.tracer.Visible  = false
        end
    end

    -- HEALTH BAR
    if obj.healthBar then
        local sp, on = Camera:WorldToViewportPoint(root.Position)
        if on then
            local hp   = hum.Health / hum.MaxHealth
            local barH = 50
            local barW = 4

            obj.healthBar.frame.Position = UDim2.new(0, sp.X - 18, 0, sp.Y - barH / 2)
            obj.healthBar.frame.Size     = UDim2.new(0, barW, 0, barH)
            obj.healthBar.fill.Size      = UDim2.new(1, 0, hp, 0)
            obj.healthBar.fill.Position  = UDim2.new(0, 0, 1 - hp, 0)
            obj.healthBar.fill.BackgroundColor3 = Color3.fromHSV(hp * 0.33, 1, 1)
            obj.healthBar.frame.Visible  = true
        else
            obj.healthBar.frame.Visible  = false
        end
    end
end

function ESP.cleanObj(obj)
    if not obj then return end
    if obj.highlight  then obj.highlight:Destroy()  end
    if obj.billboard  then obj.billboard:Destroy()  end
    if obj.tracer     then obj.tracer:Destroy()     end
    if obj.box        then obj.box.frame:Destroy()  end
    if obj.healthBar  then obj.healthBar.frame:Destroy() end
    for _, sk in ipairs(obj.skeleton or {}) do sk.line:Destroy() end
end

function ESP.enableAll()
    ESP.disableAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then ESP.setupPlayer(p) end
    end
end

function ESP.disableAll()
    for p, obj in pairs(State.ESPObjects) do
        ESP.cleanObj(obj)
    end
    State.ESPObjects = {}
end

