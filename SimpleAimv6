-- ══════════════════════════════════════
--  UTILS
-- ══════════════════════════════════════
local function alive(char)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function getVel(char)
    local r = char and char:FindFirstChild("HumanoidRootPart")
    return (r and r:IsA("BasePart")) and r.AssemblyLinearVelocity or Vector3.zero
end

local function shouldHit()
    if not CFG.LegitMode then return true end
    ST.HitTick += 1
    return (ST.HitTick % math.max(1, math.floor(100 / CFG.HitChance))) == 0
end

local function wallOk(origin, pos, char)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Blacklist
    p.FilterDescendantsInstances = {LP.Character or {}}
    local r = workspace:Raycast(origin, pos - origin, p)
    if r then return r.Instance:FindFirstAncestorOfClass("Model") == char end
    return true
end

-- ══════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════
local function getTarget()
    local best, bestD = nil, CFG.FOV
    local center = CAM.ViewportSize / 2

    for _, p in ipairs(PL:GetPlayers()) do
        if p == LP then continue end
        local c = p.Character
        if not alive(c) then continue end

        local part = c:FindFirstChild(CFG.Part) or c:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local tpos = part.Position
        if CFG.Predict then tpos = tpos + getVel(c) * CFG.PredMult end

        local sp, on = CAM:WorldToViewportPoint(tpos)
        if not on then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d >= bestD then continue end

        if CFG.WallCheck and not wallOk(CAM.CFrame.Position, tpos, c) then continue end

        best  = {part = part, char = c, player = p, pos = tpos}
        bestD = d
    end
    return best
end

local function aimUpdate()
    if not CFG.AimOn then ST.Target = nil; ST.Locked = false; return end
    if CFG.ScopeOnly and CAM.FieldOfView >= 50 then return end
    if not shouldHit() then return end

    local t = getTarget()
    ST.Target = t
    ST.Locked = t ~= nil

    if t then
        local goal = CFrame.new(CAM.CFrame.Position, t.pos)
        CAM.CFrame = CAM.CFrame:Lerp(goal, 1 - CFG.Smooth)
    end
end

