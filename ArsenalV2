-- ══════════════════════════════════════
--  DRAG TOUCH + MOUSE
-- ══════════════════════════════════════
do
    local drag=false; local tid=nil; local si=nil; local sp=nil

    header.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch and not tid then
            tid=i; drag=true
            si=Vector2.new(i.Position.X,i.Position.Y); sp=panel.Position
        elseif i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true
            si=Vector2.new(i.Position.X,i.Position.Y); sp=panel.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        local pos
        if i.UserInputType==Enum.UserInputType.Touch and i==tid then
            pos=Vector2.new(i.Position.X,i.Position.Y)
        elseif i.UserInputType==Enum.UserInputType.MouseMovement then
            pos=Vector2.new(i.Position.X,i.Position.Y)
        end
        if pos then
            local d=pos-si
            panel.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if (i.UserInputType==Enum.UserInputType.Touch and i==tid)
        or i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=false; tid=nil
        end
    end)
end

