-- ══════════════════════════════════════
--  GUI HELPERS
-- ══════════════════════════════════════
local function crn(o, r)
    Instance.new("UICorner", o).CornerRadius = r or UDim.new(0, 6)
end
local function stk(o, c, th, a)
    local s = Instance.new("UIStroke")
    s.Color       = c  or CFG.C_BORDER
    s.Thickness   = th or 1
    s.Transparency= a  or 0.4
    s.Parent      = o
    return s
end
local function tw(o, p, t)
    TS:Create(o, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quart), p):Play()
end

local function mkLbl(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel        = 0
    for k, v in pairs(props) do
        if k ~= "P" then l[k] = v end
    end
    if props.P then l.Parent = props.P end
    return l
end

local function mkBtn(parent, props)
    local b = Instance.new("TextButton")
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    for k, v in pairs(props) do
        if k ~= "P" and k ~= "R" then b[k] = v end
    end
    if props.R then crn(b, props.R) end
    if props.P then b.Parent = props.P end
    return b
end

-- Switch
local function mkSwitch(parent, cb)
    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0, 40, 0, 22)
    track.BackgroundColor3 = CFG.C_OFF
    track.BorderSizePixel  = 0
    track.Parent           = parent
    crn(track, UDim.new(1, 0))

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 16, 0, 16)
    thumb.Position         = UDim2.new(0, 3, 0.5, -8)
    thumb.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    crn(thumb, UDim.new(1, 0))

    local on = false
    local function set(v)
        on = v
        tw(track, {BackgroundColor3 = on and CFG.C_ON or CFG.C_OFF})
        tw(thumb, {
            Position         = on and UDim2.new(0, 20, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
            BackgroundColor3 = on and Color3.fromRGB(200, 160, 255) or Color3.fromRGB(100, 100, 120),
        })
        if cb then cb(on) end
    end

    local b = mkBtn(track, {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, Text=""})
    b.MouseButton1Click:Connect(function() set(not on) end)
    return track, set
end

-- Slider
local function mkSlider(parent, label, min, max, default, order, cb)
    local wrap = Instance.new("Frame")
    wrap.Size             = UDim2.new(1, 0, 0, 52)
    wrap.BackgroundColor3 = CFG.C_CARD
    wrap.BorderSizePixel  = 0
    wrap.LayoutOrder      = order
    wrap.Parent           = parent
    crn(wrap)

    mkLbl(wrap, {
        Size             = UDim2.new(1, -70, 0, 18),
        Position         = UDim2.new(0, 10, 0, 5),
        Text             = label,
        TextColor3       = CFG.C_TEXT,
        Font             = Enum.Font.GothamMedium,
        TextSize         = 11,
        TextXAlignment   = Enum.TextXAlignment.Left,
        P                = wrap,
    })

    local vbox = Instance.new("TextBox")
    vbox.Size             = UDim2.new(0, 52, 0, 20)
    vbox.Position         = UDim2.new(1, -60, 0, 4)
    vbox.BackgroundColor3 = Color3.fromRGB(24, 24, 36)
    vbox.BorderSizePixel  = 0
    vbox.Text             = tostring(default)
    vbox.TextColor3       = CFG.C_ACCENT
    vbox.Font             = Enum.Font.GothamBold
    vbox.TextSize         = 11
    vbox.ClearTextOnFocus = true
    vbox.Parent           = wrap
    crn(vbox, UDim.new(0, 4))

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -20, 0, 5)
    track.Position         = UDim2.new(0, 10, 0, 36)
    track.BackgroundColor3 = Color3.fromRGB(28, 28, 42)
    track.BorderSizePixel  = 0
    track.Parent           = wrap
    crn(track, UDim.new(1, 0))

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = CFG.C_ACCENT
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    crn(fill, UDim.new(1, 0))

    local knob = Instance.new("Frame")
    knob.Size         = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint  = Vector2.new(0.5, 0.5)
    knob.Position     = UDim2.new((default-min)/(max-min), 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(170, 90, 255)
    knob.BorderSizePixel  = 0
    knob.ZIndex       = 3
    knob.Parent       = track
    crn(knob, UDim.new(1, 0))

    local val  = default
    local drag = false

    local function upd(v)
        v   = math.clamp(math.floor(v), min, max)
        val = v
        local rel = (v-min)/(max-min)
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        vbox.Text     = tostring(v)
        if cb then cb(v) end
    end
    local function fromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        upd(min + rel*(max-min))
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; fromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then fromX(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
    vbox.FocusLost:Connect(function()
        local n = tonumber(vbox.Text)
        if n then upd(n) else vbox.Text = tostring(val) end
    end)

    return wrap
end

