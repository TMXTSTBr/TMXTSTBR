-- Big toggle button
local function mkBigBtn(parent, text, order, onCb, offCb)
    local b = mkBtn(parent, {
        Size             = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Color3.fromRGB(22, 10, 40),
        Text             = text .. "  ·  OFF",
        TextColor3       = CFG.C_SUB,
        Font             = Enum.Font.GothamBlack,
        TextSize         = 13,
        LayoutOrder      = order,
        R                = UDim.new(0, 6),
        P                = parent,
    })
    stk(b, CFG.C_BORDER, 1, 0.4)

    local isOn = false
    b.MouseButton1Click:Connect(function()
        isOn = not isOn
        if isOn then
            tw(b, {BackgroundColor3 = Color3.fromRGB(55, 15, 95)})
            b.TextColor3 = CFG.C_ACCENT
            b.Text       = text .. "  ·  ON"
            if onCb then onCb() end
        else
            tw(b, {BackgroundColor3 = Color3.fromRGB(22, 10, 40)})
            b.TextColor3 = CFG.C_SUB
            b.Text       = text .. "  ·  OFF"
            if offCb then offCb() end
        end
    end)
    return b
end

