-- ══════════════════════════════════════
--  ARSENAL UTILS
-- ══════════════════════════════════════

-- Arsenal usa times via "Team" no Player
local function getTeam(p)
    return p and p.Team
end

local function isTeammate(p)
    if not CFG.TeamCheck then return false end
    local mt = getTeam(LP)
    local pt = getTeam(p)
    if mt and pt and mt == pt then return true end
    return false
end

local function isAlive(char)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function getVel(char)
    local r = char and char:FindFirstChild("HumanoidRootPart")
    return (r and r:IsA("BasePart")) and r.AssemblyLinearVelocity or Vector3.zero
end

-- Cor baseada em team
local function espColor(p)
    if isTeammate(p) then return CFG.C_TEAM end
    return CFG.C_ENEMY
end

-- ══════════════════════════════════════
--  FPS
-- ══════════════════════════════════════
local lastT = tick()
RS.Heartbeat:Connect(function()
    local now = tick()
    local dt  = now - lastT
    lastT     = now
    table.insert(ST.FPSBuf, 1/math.max(dt, 0.001))
    if #ST.FPSBuf > 20 then table.remove(ST.FPSBuf, 1) end
    local s = 0
    for _, v in ipairs(ST.FPSBuf) do s += v end
    ST.FPS = math.floor(s / #ST.FPSBuf)
end)

-- ══════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════
local function getTarget()
    local best, bestD = nil, CFG.FOV
    local center = CAM.ViewportSize / 2

    for _, p in ipairs(PL:GetPlayers()) do
        if p == LP then continue end
        if isTeammate(p) then continue end -- Team check

        local c = p.Character
        if not isAlive(c) then continue end

        local part = c:FindFirstChild(CFG.Part)
            or c:FindFirstChild("UpperTorso")
            or c:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local sp, on = CAM:WorldToViewportPoint(part.Position)
        if not on then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d >= bestD then continue end

        best  = {part = part, char = c, player = p}
        bestD = d
    end
    return best
end

local function aimUpdate()
    if not CFG.AimOn then
        ST.Target = nil
        ST.Locked = false
        return
    end

    local t = getTarget()
    ST.Target = t
    ST.Locked = t ~= nil

    if t then
        local goal = CFrame.new(CAM.CFrame.Position, t.part.Position)
        CAM.CFrame = CAM.CFrame:Lerp(goal, 1 - CFG.Smooth)
    end
end

-- ══════════════════════════════════════
--  ANTI-RECOIL
-- ══════════════════════════════════════
UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        ST.Shooting = true
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        ST.Shooting = false
    end
end)

local function startRecoil()
    if ST.RConn then ST.RConn:Disconnect() end
    ST.RConn = RS.RenderStepped:Connect(function()
        if CFG.RecoilOn and ST.Shooting then
            CAM.CFrame = CAM.CFrame * CFrame.fromEulerAnglesXYZ(
                -math.rad(CFG.RecoilY * 0.016), 0, 0
            )
        end
    end)
end

local function stopRecoil()
    if ST.RConn then ST.RConn:Disconnect(); ST.RConn = nil end
end

