--  ESP
-- ══════════════════════════════════════
local SG -- declarado depois

local ESP = {}

function ESP.remove(p)
    local d = ST.ESPData[p]
    if not d then return end
    pcall(function()
        if d.hl  then d.hl:Destroy()  end
        if d.bb  then d.bb:Destroy()  end
        if d.box then d.box:Destroy() end
        if d.hbf then d.hbf:Destroy() end
    end)
    ST.ESPData[p] = nil
end

function ESP.add(p)
    ESP.remove(p)

    local function build(char)
        if not char then return end
        task.wait(0.4)
        if not char.Parent then return end
        if ST.ESPData[p] then ESP.remove(p) end

        local d = {}
        ST.ESPData[p] = d

        -- Highlight / Chams
        local hl = Instance.new("Highlight")
        hl.FillTransparency    = 0.82
        hl.OutlineTransparency = 0.08
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled             = CFG.ChamsOn
        hl.Parent              = char
        d.hl                   = hl

        -- Billboard (nome + dist)
        local head = char:FindFirstChild("Head")
        if head then
            local bb = Instance.new("BillboardGui")
            bb.Size        = UDim2.new(0, 120, 0, 38)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent      = head
            d.bb           = bb

            local nl = Instance.new("TextLabel")
            nl.Name                   = "NL"
            nl.Size                   = UDim2.new(1, 0, 0.55, 0)
            nl.BackgroundTransparency = 1
            nl.Font                   = Enum.Font.GothamBold
            nl.TextSize               = 12
            nl.TextStrokeTransparency = 0.3
            nl.Visible                = CFG.NameOn
            nl.Parent                 = bb

            local dl = Instance.new("TextLabel")
            dl.Name                   = "DL"
            dl.Size                   = UDim2.new(1, 0, 0.45, 0)
            dl.Position               = UDim2.new(0, 0, 0.55, 0)
            dl.BackgroundTransparency = 1
            dl.Font                   = Enum.Font.Gotham
            dl.TextSize               = 10
            dl.TextStrokeTransparency = 0.4
            dl.Visible                = CFG.DistOn
            dl.Parent                 = bb
        end

        -- Box 2D
        local boxF = Instance.new("Frame")
        boxF.BackgroundTransparency = 1
        boxF.BorderSizePixel        = 0
        boxF.ZIndex                 = 10
        boxF.Visible                = false
        boxF.Parent                 = SG
        d.box      = boxF
        d.boxSides = {}
        for i = 1, 4 do
            local s = Instance.new("Frame")
            s.BorderSizePixel = 0
            s.ZIndex          = 10
            s.Parent          = boxF
            d.boxSides[i]     = s
        end

        -- Health bar
        local hbf = Instance.new("Frame")
        hbf.BackgroundColor3       = Color3.fromRGB(15, 15, 15)
        hbf.BackgroundTransparency = 0.3
        hbf.BorderSizePixel        = 0
        hbf.ZIndex                 = 11
        hbf.Visible                = false
        hbf.Parent                 = SG
        d.hbf = hbf

        local hbFill = Instance.new("Frame")
        hbFill.BorderSizePixel = 0
        hbFill.ZIndex          = 12
        hbFill.Parent          = hbf
        d.hbFill               = hbFill

        -- Loop ESP
        task.spawn(function()
            while ST.ESPData[p] == d and char.Parent and CFG.ESPOn do
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local myR  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not root or not hum then task.wait(0.05); continue end

                -- Cor baseada em team
                local col = espColor(p)
                if ST.Target and ST.Target.player == p then col = CFG.C_YELLOW end
                if hum.Health <= 0 then col = CFG.C_RED end

                -- Não mostrar ESP em teammates se TeamESP ativo
                local hide = CFG.TeamESP and isTeammate(p)

                d.hl.Enabled      = CFG.ChamsOn and not hide
                d.hl.OutlineColor = col
                d.hl.FillColor    = col

                -- Nome e distância
                if d.bb then
                    local nl = d.bb:FindFirstChild("NL")
                    local dl = d.bb:FindFirstChild("DL")
                    if nl then
                        nl.Text       = p.Name
                        nl.TextColor3 = col
                        nl.Visible    = CFG.NameOn and not hide
                    end
                    if dl then
                        dl.Visible = CFG.DistOn and not hide
                        if CFG.DistOn and myR and not hide then
                            local dist = math.floor((root.Position - myR.Position).Magnitude)
                            dl.Text       = dist .. "m"
                            dl.TextColor3 = col
                        end
                    end
                end

                -- Bounding box
                local pts = {
                    "Head","UpperTorso","LowerTorso",
                    "LeftHand","RightHand","LeftFoot","RightFoot"
                }
                local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
                local allOn = true
                for _, pn in ipairs(pts) do
                    local pp = char:FindFirstChild(pn)
                    if pp then
                        local sp2, on2 = CAM:WorldToViewportPoint(pp.Position)
                        if not on2 then allOn = false; break end
                        if sp2.X < minX then minX = sp2.X end
                        if sp2.Y < minY then minY = sp2.Y end
                        if sp2.X > maxX then maxX = sp2.X end
                        if sp2.Y > maxY then maxY = sp2.Y end
                    end
                end

                -- Box
                local showBox = CFG.BoxOn and allOn and not hide
                d.box.Visible = showBox
                if showBox then
                    local pad, t2 = 3, 1.5
                    local bx = minX - pad; local by = minY - pad
                    local bw = (maxX - minX) + pad*2
                    local bh = (maxY - minY) + pad*2
                    d.box.Position = UDim2.new(0, bx, 0, by)
                    d.box.Size     = UDim2.new(0, bw, 0, bh)
                    local s = d.boxSides
                    s[1].Position=UDim2.new(0,0,0,0);    s[1].Size=UDim2.new(1,0,0,t2); s[1].BackgroundColor3=col
                    s[2].Position=UDim2.new(0,0,1,-t2);  s[2].Size=UDim2.new(1,0,0,t2); s[2].BackgroundColor3=col
                    s[3].Position=UDim2.new(0,0,0,0);    s[3].Size=UDim2.new(0,t2,1,0); s[3].BackgroundColor3=col
                    s[4].Position=UDim2.new(1,-t2,0,0);  s[4].Size=UDim2.new(0,t2,1,0); s[4].BackgroundColor3=col
                end

                -- Health bar
                local showHP = CFG.HealthOn and allOn and not hide
                d.hbf.Visible = showHP
                if showHP then
                    local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    d.hbf.Position      = UDim2.new(0, minX - 7, 0, minY)
                    d.hbf.Size          = UDim2.new(0, 4, 0, maxY - minY)
                    d.hbFill.Size       = UDim2.new(1, 0, hp, 0)
                    d.hbFill.Position   = UDim2.new(0, 0, 1 - hp, 0)
                    d.hbFill.BackgroundColor3 = Color3.fromHSV(hp * 0.33, 1, 1)
                end

                task.wait(0)
            end
            ESP.remove(p)
        end)
    end

    if p.Character then build(p.Character) end
    p.CharacterAdded:Connect(build)
end

function ESP.enable()
    ESP.disable()
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP then ESP.add(p) end
    end
    PL.PlayerAdded:Connect(function(p)
        if p ~= LP and CFG.ESPOn then ESP.add(p) end
    end)
    PL.PlayerRemoving:Connect(ESP.remove)
end

function ESP.disable()
    for p in pairs(ST.ESPData) do ESP.remove(p) end
end

