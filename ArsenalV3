    local s = CFG.FOV * 2
    local fr = Instance.new("Frame")
    fr.Size = UDim2.new(0,s,0,s)
    fr.Position = UDim2.new(0.5,-s/2,0.5,-s/2)
    fr.BackgroundTransparency = 1
    fr.BorderSizePixel = 0
