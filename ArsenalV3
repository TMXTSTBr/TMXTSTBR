--  EXPAND / COLLAPSE
-- ══════════════════════════════════════
local expanded = false
local FULL_H   = 520   -- mais longo

local function doToggle()
    expanded = not expanded
    if expanded then
        content.Visible = true
        arrowBtn.Text   = "↑"
        tw(panel, {Size = UDim2.new(0, PW, 0, FULL_H)}, 0.25)
        tw(pStk,  {Transparency = 0.1})
    else
        arrowBtn.Text = "↓"
        tw(panel, {Size = UDim2.new(0, PW, 0, H_HDR)}, 0.2)
        tw(pStk,  {Transparency = 0.3})
        task.delay(0.22, function()
            if not expanded then content.Visible = false end
        end)
    end
end

