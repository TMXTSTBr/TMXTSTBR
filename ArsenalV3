local expanded = false

local function doExpand()
    expanded = not expanded

    if expanded then
        -- mostrar tudo
        monBar.Visible = true
        scroll.Visible = true
        arrow.Text     = "↑"
    else
        -- esconder
        monBar.Visible = false
        scroll.Visible = false
        arrow.Text     = "↓"
    end
end

-- Conectar seta
