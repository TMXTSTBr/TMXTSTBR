local function mkBtn(parent, label, desc, order, cb)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(1,0,0,desc and RH+12 or RH)
    btn.BackgroundColor3=C.CARD; btn.BorderSizePixel=0
    btn.Text=""; btn.AutoButtonColor=false
    btn.LayoutOrder=order; btn.ZIndex=6; btn.Parent=parent
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,5)
    Instance.new("UIStroke",btn).Color=C.BL

    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-10,0,18); lbl.Position=UDim2.new(0,10,0,desc and 5 or 6)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=C.W; lbl.Font=Enum.Font.GothamBlack; lbl.TextSize=12
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=7; lbl.Parent=btn

    if desc then
        local dl=Instance.new("TextLabel")
        dl.Size=UDim2.new(1,-10,0,12); dl.Position=UDim2.new(0,10,0,22)
        dl.BackgroundTransparency=1; dl.Text=desc
        dl.TextColor3=C.WDD; dl.Font=Enum.Font.Gotham; dl.TextSize=9
        dl.TextXAlignment=Enum.TextXAlignment.Left; dl.ZIndex=7; dl.Parent=btn
    end

    local busy=false
    local function tap()
        if busy then return end; busy=true
        TS:Create(btn,TweenInfo.new(0.08),{BackgroundColor3=C.C2}):Play()
        task.delay(0.18,function()
            TS:Create(btn,TweenInfo.new(0.12),{BackgroundColor3=C.CARD}):Play()
            busy=false
        end)
        if cb then cb() end
    end
    btn.MouseButton1Click:Connect(tap)
    btn.Activated:Connect(tap)
    return btn
end

