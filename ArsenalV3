-- ══════════════════════════════════════
--  MONITORES
-- ══════════════════════════════════════
local MON = {FPS=0, PING=0, RAM=0}
local fBuf = {}
local lastT = tick()

-- FPS real
RS.Heartbeat:Connect(function()
    local now = tick()
    local dt  = now - lastT
    lastT     = now
    table.insert(fBuf, 1/math.max(dt,0.001))
    if #fBuf > 30 then table.remove(fBuf,1) end
    local s=0; for _,v in ipairs(fBuf) do s=s+v end
    MON.FPS = math.floor(s/#fBuf)
end)

-- PING e RAM em loop separado
task.spawn(function()
    while true do
        pcall(function()
            MON.PING = math.floor(LP:GetNetworkPing()*1000)
        end)
        pcall(function()
            MON.RAM = math.floor(collectgarbage("count")/1024)
        end)
        task.wait(1)
    end
end)

-- ══════════════════════════════════════
--  BOOST FUNCTIONS
-- ══════════════════════════════════════
local origEnv = {}
-- salvar
origEnv.shadows = LT.GlobalShadows
origEnv.bright  = LT.Brightness
origEnv.fogEnd  = LT.FogEnd
origEnv.fogSt   = LT.FogStart
origEnv.clock   = LT.ClockTime
origEnv.envD    = LT.EnvironmentDiffuseScale
origEnv.envS    = LT.EnvironmentSpecularScale

local function applyShadows(on)
    LT.GlobalShadows = not on
end

local function applyFog(on)
    if on then LT.FogEnd=99999; LT.FogStart=99998
    else LT.FogEnd=origEnv.fogEnd; LT.FogStart=origEnv.fogSt end
end

local function applyParticles(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ParticleEmitter") or o:IsA("Trail")
        or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles") then
            pcall(function() o.Enabled = not on end)
        end
    end
end

local function applyDecals(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Decal") or o:IsA("Texture") then
            pcall(function() o.Transparency = on and 1 or 0 end)
        end
    end
end

local function applyTextures(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("SpecialMesh") then
            pcall(function()
                if on then
                    if not origEnv[o] then origEnv[o]=o.TextureId end
                    o.TextureId=""
                else
                    if origEnv[o] then o.TextureId=origEnv[o] end
                end
            end)
        end
    end
end

local function applyLights(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
            pcall(function() o.Enabled = not on end)
        end
    end
end

local function applyPostFX(on)
    for _,o in ipairs(LT:GetChildren()) do
        if o:IsA("BloomEffect") or o:IsA("BlurEffect")
        or o:IsA("ColorCorrectionEffect") or o:IsA("SunRaysEffect")
        or o:IsA("DepthOfFieldEffect") then
            pcall(function() o.Enabled = not on end)
        end
    end
end

local function applyAtmosphere(on)
    for _,o in ipairs(LT:GetChildren()) do
        if o:IsA("Atmosphere") or o:IsA("Sky") then
            pcall(function() o.Enabled = not on end)
        end
    end
end

local function applyBillboards(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BillboardGui") or o:IsA("SurfaceGui") then
            pcall(function() o.Enabled = not on end)
        end
    end
end

local function applyLOD(on)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") then
            pcall(function()
                o.RenderFidelity = on
                    and Enum.RenderFidelity.Performance
                    or  Enum.RenderFidelity.Automatic
            end)
        end
    end
end

local function applySounds(on)
    SS.Volume = on and 0 or 0.5
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Sound") then
            pcall(function() o.Volume = on and 0 or 0.5 end)
        end
    end
end

local function applyFlat(on)
    if on then
        LT.EnvironmentDiffuseScale=0; LT.EnvironmentSpecularScale=0
    else
        LT.EnvironmentDiffuseScale=origEnv.envD
        LT.EnvironmentSpecularScale=origEnv.envS
    end
end

local function applyNight(on)
    if on then LT.ClockTime=0; LT.Brightness=0.1
    else LT.ClockTime=origEnv.clock; LT.Brightness=origEnv.bright end
end

local function applyWater(on)
    local t=workspace:FindFirstChildOfClass("Terrain")
    if t then
        pcall(function()
            t.WaterWaveSize    = on and 0 or 0.15
            t.WaterWaveSpeed   = on and 0 or 3
            t.WaterReflectance = on and 0 or 0.5
        end)
    end
end

local function applyQuality(v)
    local q={
        Enum.QualityLevel.Level01,Enum.QualityLevel.Level02,
        Enum.QualityLevel.Level03,Enum.QualityLevel.Level04,
        Enum.QualityLevel.Level05,Enum.QualityLevel.Level06,
        Enum.QualityLevel.Level07,Enum.QualityLevel.Level08,
        Enum.QualityLevel.Level09,Enum.QualityLevel.Level10,
    }
    pcall(function() settings().Rendering.QualityLevel=q[v] end)
end

local function presetLight()
    applyShadows(true); applyParticles(true)
    applyPostFX(true); applyQuality(5)
end

local function presetMedium()
    applyShadows(true); applyParticles(true); applyDecals(true)
    applyPostFX(true); applyLights(true); applyAtmosphere(true)
    applyQuality(3)
end

local function presetMax()
    applyShadows(true); applyParticles(true); applyDecals(true)
    applyTextures(true); applySounds(true); applyPostFX(true)
    applyLights(true); applyAtmosphere(true); applyBillboards(true)
    applyLOD(true); applyWater(true); applyFlat(true)
    applyQuality(1); collectgarbage("collect")
end

local function restoreAll()
    applyShadows(false); applyFog(false); applyParticles(false)
    applyDecals(false); applyTextures(false); applySounds(false)
    applyPostFX(false); applyLights(false); applyAtmosphere(false)
    applyBillboards(false); applyLOD(false); applyWater(false)
    applyFlat(false); applyNight(false); applyQuality(10)
end

