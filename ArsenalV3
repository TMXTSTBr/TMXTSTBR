-- Switch simples e confiável
local function mkSwitch(parent, init, cb)
    -- Frame externo (área de toque toda)
    local area=Instance.new("Frame")
    area.Size=UDim2.new(0,PW-16,0,26)
    area.BackgroundColor3=BD
    area.BorderSizePixel=0
    area.Parent=parent
    Instance.new("UICorner",area).CornerRadius=UDim.new(0,4)

    -- Texto
    local txt=Instance.new("TextLabel")
    txt.Size=UDim2.new(1,-50,1,0); txt.Position=UDim2.new(0,8,0,0)
    txt.BackgroundTransparency=1; txt.BorderSizePixel=0
    txt.TextColor3=W; txt.Font=Enum.Font.GothamMedium; txt.TextSize=10
    txt.TextXAlignment=Enum.TextXAlignment.Left
    txt.Text=area.Name
    txt.Parent=area

    -- Indicador quadrado (simples, sem arredondamento excessivo)
    local box=Instance.new("Frame")
    box.Size=UDim2.new(0,28,0,14)
    box.AnchorPoint=Vector2.new(1,0.5)
    box.Position=UDim2.new(1,-6,0.5,0)
    box.BackgroundColor3=init and ON or OF
    box.BorderSizePixel=0
    box.Parent=area
    Instance.new("UICorner",box).CornerRadius=UDim.new(1,0)

    local dot=Instance.new("Frame")
    dot.Size=UDim2.new(0,10,0,10)
    dot.AnchorPoint=Vector2.new(0.5,0.5)
    dot.Position=init and UDim2.new(0,20,0.5,0) or UDim2.new(0,8,0.5,0)
    dot.BackgroundColor3=init and BG or WD
    dot.BorderSizePixel=0
    dot.Parent=box
    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0)

    local on=init or false

    local function set(v)
        on=v
        TS:Create(box,TweenInfo.new(0.15),{BackgroundColor3=on and ON or OF}):Play()
        TS:Create(dot,TweenInfo.new(0.15),{
            Position=on and UDim2.new(0,20,0.5,0) or UDim2.new(0,8,0.5,0),
            BackgroundColor3=on and BG or WD,
        }):Play()
        if cb then cb(on) end
    end

    -- ImageButton cobre TUDO - mais confiável no mobile
    local hit=Instance.new("ImageButton")
    hit.Size=UDim2.new(1,0,1,0); hit.BackgroundTransparency=1
    hit.BorderSizePixel=0; hit.Image=""; hit.ZIndex=10; hit.Parent=area
    hit.MouseButton1Click:Connect(function() set(not on) end)
    hit.Activated:Connect(function() set(not on) end)

    return area, txt, set
end

