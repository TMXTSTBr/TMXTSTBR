local expanded=false

local function doExpand()
    expanded=not expanded
    if expanded then
        scroll.Visible=true
        arrowL.Text="↑"
        TS:Create(panel,TweenInfo.new(0.22,Enum.EasingStyle.Quart),
            {Size=UDim2.new(0,PW,0,H_F)}):Play()
    else
        arrowL.Text="↓"
        TS:Create(panel,TweenInfo.new(0.18,Enum.EasingStyle.Quart),
            {Size=UDim2.new(0,PW,0,H_H)}):Play()
        task.delay(0.19,function()
            if not expanded then scroll.Visible=false end
        end)
    end
end

