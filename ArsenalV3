-- Switch: o row inteiro é clicável
local function mkSw(parent, label, order, init, cb)
    local row=Instance.new("TextButton")
    row.Size=UDim2.new(1,0,0,RH)
    row.BackgroundColor3=C.CARD
    row.BorderSizePixel=0; row.Text=""
    row.AutoButtonColor=false
    row.LayoutOrder=order; row.ZIndex=6; row.Parent=parent
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,5)

    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,-55,1,0); lbl.Position=UDim2.new(0,10,0,0)
    lbl.BackgroundTransparency=1; lbl.Text=label
    lbl.TextColor3=C.W; lbl.Font=Enum.Font.GothamMedium; lbl.TextSize=11
    lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.ZIndex=7; lbl.Parent=row

    local track=Instance.new("Frame")
    track.Size=UDim2.new(0,34,0,18); track.AnchorPoint=Vector2.new(1,0.5)
    track.Position=UDim2.new(1,-8,0.5,0)
    track.BackgroundColor3=init and C.ON or C.OFF
    track.BorderSizePixel=0; track.ZIndex=7; track.Parent=row
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local dot=Instance.new("Frame")
    dot.Size=UDim2.new(0,12,0,12); dot.AnchorPoint=Vector2.new(0.5,0.5)
    dot.Position=init and UDim2.new(0,25,0.5,0) or UDim2.new(0,9,0.5,0)
    dot.BackgroundColor3=init and C.BG or C.WD
    dot.BorderSizePixel=0; dot.ZIndex=8; dot.Parent=track
    Instance.new("UICorner",dot).CornerRadius=UDim.new(1,0)

    local on=init or false
    local function set(v)
        on=v
        TS:Create(track,TweenInfo.new(0.14),{BackgroundColor3=on and C.ON or C.OFF}):Play()
        TS:Create(dot,TweenInfo.new(0.14),{
            Position=on and UDim2.new(0,25,0.5,0) or UDim2.new(0,9,0.5,0),
            BackgroundColor3=on and C.BG or C.WD,
        }):Play()
        if cb then cb(on) end
    end

    row.MouseButton1Click:Connect(function() set(not on) end)
    row.Activated:Connect(function() set(not on) end)
    return row
end

-- Slider
local function mkSl(parent, label, min, max, default, order, cb)
    local wrap=Instance.new("Frame")
    wrap.Size=UDim2.new(1,0,0,SLH); wrap.BackgroundColor3=C.CARD
    wrap.BorderSizePixel=0; wrap.LayoutOrder=order; wrap.ZIndex=6; wrap.Parent=parent
    Instance.new("UICorner",wrap).CornerRadius=UDim.new(0,5)

    local tl=Instance.new("TextLabel")
    tl.Size=UDim2.new(1,-46,0,18); tl.Position=UDim2.new(0,10,0,4)
    tl.BackgroundTransparency=1; tl.Text=label
    tl.TextColor3=C.WD; tl.Font=Enum.Font.GothamMedium; tl.TextSize=10
    tl.TextXAlignment=Enum.TextXAlignment.Left; tl.ZIndex=7; tl.Parent=wrap

    local vb=Instance.new("TextBox")
    vb.Size=UDim2.new(0,36,0,18); vb.Position=UDim2.new(1,-42,0,4)
    vb.BackgroundColor3=C.C2; vb.BorderSizePixel=0
    vb.Text=tostring(default); vb.TextColor3=C.W
    vb.Font=Enum.Font.GothamBold; vb.TextSize=10
    vb.ClearTextOnFocus=true; vb.ZIndex=7; vb.Parent=wrap
    Instance.new("UICorner",vb).CornerRadius=UDim.new(0,4)

    local track=Instance.new("Frame")
    track.Size=UDim2.new(1,-20,0,4); track.Position=UDim2.new(0,10,0,32)
    track.BackgroundColor3=C.C2; track.BorderSizePixel=0; track.ZIndex=7; track.Parent=wrap
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)

    local fill=Instance.new("Frame")
    fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3=C.W; fill.BorderSizePixel=0; fill.ZIndex=8; fill.Parent=track
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,12,0,12); knob.AnchorPoint=Vector2.new(0.5,0.5)
    knob.Position=UDim2.new((default-min)/(max-min),0,0.5,0)
    knob.BackgroundColor3=C.W; knob.BorderSizePixel=0; knob.ZIndex=9; knob.Parent=track
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local val=default; local drag=false
    local function upd(v)
        v=math.clamp(math.floor(v),min,max); val=v
        local r=(v-min)/(max-min)
        fill.Size=UDim2.new(r,0,1,0); knob.Position=UDim2.new(r,0,0.5,0)
        vb.Text=tostring(v); if cb then cb(v) end
    end
    local function fx(x)
        local r=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
        upd(min+r*(max-min))
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true; fx(i.Position.X) end
    end)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseMovement then fx(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
    vb.FocusLost:Connect(function()
        local n=tonumber(vb.Text); if n then upd(n) else vb.Text=tostring(val) end
    end)
    return wrap
end

