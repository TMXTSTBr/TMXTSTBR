local function mkRow(parent, text, order, init, cb)
    local row = Instance.new("Frame")
    row.Size             = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = C.CARD
    row.BorderSizePixel  = 0
    row.LayoutOrder      = order
    row.Parent           = parent
    crn(row)

    lbl(row, {
        text  = text,
        color = C.TEXT,
        font  = Enum.Font.GothamMedium,
        size  = 11,
        align = Enum.TextXAlignment.Left,
        sz    = UDim2.new(1,-70,1,0),
        pos   = UDim2.new(0,10,0,0),
    })

    local _, fn = mkSwitch(row, init, cb)
    return row, fn
end

-- ══════════════════════════════════════
--  SLIDER
-- ══════════════════════════════════════
local function mkSlider(parent, text, min, max, default, order, cb)
    local wrap = Instance.new("Frame")
    wrap.Size             = UDim2.new(1, 0, 0, 48)
    wrap.BackgroundColor3 = C.CARD
    wrap.BorderSizePixel  = 0
    wrap.LayoutOrder      = order
    wrap.Parent           = parent
    crn(wrap)

    lbl(wrap, {
        text  = text,
        color = C.TEXT,
        font  = Enum.Font.GothamMedium,
        size  = 11,
        align = Enum.TextXAlignment.Left,
        sz    = UDim2.new(1,-60,0,18),
        pos   = UDim2.new(0,10,0,3),
    })

    -- Caixa de valor
    local vb = Instance.new("TextBox")
    vb.Size             = UDim2.new(0,46,0,18)
    vb.Position         = UDim2.new(1,-54,0,3)
    vb.BackgroundColor3 = Color3.fromRGB(18,18,24)
    vb.BorderSizePixel  = 0
    vb.Text             = tostring(default)
    vb.TextColor3       = C.ACCENT
    vb.Font             = Enum.Font.GothamBold
    vb.TextSize         = 11
    vb.ClearTextOnFocus = true
    vb.Parent           = wrap
    crn(vb, UDim.new(0,4))

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1,-20,0,4)
    track.Position         = UDim2.new(0,10,0,32)
    track.BackgroundColor3 = Color3.fromRGB(24,24,32)
    track.BorderSizePixel  = 0
    track.Parent           = wrap
    crn(track, UDim.new(1,0))

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = C.ACCENT
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    crn(fill, UDim.new(1,0))

    local knob = Instance.new("Frame")
    knob.Size         = UDim2.new(0,13,0,13)
    knob.AnchorPoint  = Vector2.new(0.5,0.5)
    knob.Position     = UDim2.new((default-min)/(max-min),0,0.5,0)
    knob.BackgroundColor3 = Color3.fromRGB(150,70,255)
    knob.BorderSizePixel  = 0
    knob.ZIndex       = 3
    knob.Parent       = track
    crn(knob, UDim.new(1,0))

    local val  = default
    local drag = false

    local function upd(v)
        v = math.clamp(math.floor(v), min, max); val = v
        local r = (v-min)/(max-min)
        fill.Size     = UDim2.new(r,0,1,0)
        knob.Position = UDim2.new(r,0,0.5,0)
        vb.Text       = tostring(v)
        if cb then cb(v) end
    end

    local function fromX(x)
        local r = math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
        upd(min + r*(max-min))
    end

    -- Touch area maior no track
    local tHit = Instance.new("TextButton")
    tHit.Size                 = UDim2.new(1,0,0,28)
    tHit.Position             = UDim2.new(0,0,0.5,-14)
    tHit.BackgroundTransparency = 1
    tHit.BorderSizePixel      = 0
    tHit.Text                 = ""
    tHit.ZIndex               = 5
    tHit.Parent               = track

    tHit.MouseButton1Click:Connect(function() end)

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true; fromX(i.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then
            fromX(i.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)

    vb.FocusLost:Connect(function()
        local n = tonumber(vb.Text)
        if n then upd(n) else vb.Text = tostring(val) end
    end)

    return wrap
end

-- ══════════════════════════════════════
--  MASTER BUTTON
-- ══════════════════════════════════════
local function mkMaster(parent, text, order, onFn, offFn)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(16, 8, 28)
    btn.BorderSizePixel  = 0
    btn.Text             = text .. "  ·  OFF"
    btn.TextColor3       = C.SUB
    btn.Font             = Enum.Font.GothamBlack
    btn.TextSize         = 12
    btn.AutoButtonColor  = false
    btn.LayoutOrder      = order
    btn.Parent           = parent
    crn(btn)

    local stk = Instance.new("UIStroke")
    stk.Color       = C.BORDER
    stk.Thickness   = 1
    stk.Transparency = 0.2
    stk.Parent      = btn

    local isOn = false

    local function toggle()
        isOn = not isOn
        if isOn then
            tw(btn, {BackgroundColor3 = Color3.fromRGB(40,10,70)})
            stk.Color    = C.ACCENT
            btn.TextColor3 = C.ACCENT
            btn.Text     = text .. "  ·  ON"
            if onFn then onFn() end
        else
            tw(btn, {BackgroundColor3 = Color3.fromRGB(16,8,28)})
            stk.Color    = C.BORDER
            btn.TextColor3 = C.SUB
            btn.Text     = text .. "  ·  OFF"
            if offFn then offFn() end
        end
    end

    btn.MouseButton1Click:Connect(toggle)
    btn.Activated:Connect(toggle)

    return btn
end

-- Separador
local function mkSep(parent, order)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(1, 0, 0, 1)
    f.BackgroundColor3 = Color3.fromRGB(25, 25, 34)
    f.BorderSizePixel  = 0
    f.LayoutOrder      = order
    f.Parent           = parent
end

-- Seção
local function mkSec(parent, text, order)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(1, 0, 0, 16)
    f.BackgroundTransparency = 1
    f.LayoutOrder      = order
    f.Parent           = parent
    lbl(f, {
        text  = text,
        color = C.ACCENT,
        font  = Enum.Font.GothamBold,
        size  = 10,
        align = Enum.TextXAlignment.Left,
        sz    = UDim2.new(1,-8,1,0),
        pos   = UDim2.new(0,8,0,0),
    })
end

