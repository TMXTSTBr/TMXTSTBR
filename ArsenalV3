-- ══════════════════════════════════════
--  DRAG  (touch + mouse)
-- ══════════════════════════════════════
do
    local drag = false
    local tid  = nil
    local si, sp

    local function beginDrag(pos)
        drag = true
        si   = Vector2.new(pos.X, pos.Y)
        sp   = panel.Position
    end
    local function moveDrag(pos)
        if not drag then return end
        local d = Vector2.new(pos.X, pos.Y) - si
        panel.Position = UDim2.new(
            sp.X.Scale, sp.X.Offset + d.X,
            sp.Y.Scale, sp.Y.Offset + d.Y
        )
    end
    local function endDrag() drag = false; tid = nil end

    hdr.InputBegan:Connect(function(i)
        -- Não iniciar drag se foi no botão da seta
        if i.UserInputType == Enum.UserInputType.Touch and not tid then
            -- Verificar se o toque foi fora do botão de seta
            local rx = i.Position.X - hdr.AbsolutePosition.X
            if rx < PW - 50 then  -- fora da área do botão
                tid = i
                beginDrag(i.Position)
            end
        elseif i.UserInputType == Enum.UserInputType.MouseButton1 then
            local rx = i.Position.X - hdr.AbsolutePosition.X
            if rx < PW - 50 then
                beginDrag(i.Position)
            end
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch and i == tid then
            moveDrag(i.Position)
        elseif i.UserInputType == Enum.UserInputType.MouseMovement then
            moveDrag(i.Position)
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if (i.UserInputType == Enum.UserInputType.Touch and i == tid)
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end)
end

