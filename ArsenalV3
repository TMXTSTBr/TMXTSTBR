-- ══════════════════════════════════════
--  ESP
-- ══════════════════════════════════════
local ESP = {}

function ESP.remove(p)
    local d = ST.ESPData[p]; if not d then return end
    pcall(function()
        if d.hl  then d.hl:Destroy()  end
        if d.bb  then d.bb:Destroy()  end
        if d.box then d.box:Destroy() end
        if d.hbf then d.hbf:Destroy() end
    end)
    ST.ESPData[p] = nil
end

function ESP.add(p)
    ESP.remove(p)
    local function build(char)
        if not char then return end
        task.wait(0.35)
        if not char.Parent then return end
        if ST.ESPData[p] then ESP.remove(p) end
        local d = {}; ST.ESPData[p] = d

        local hl = Instance.new("Highlight")
        hl.FillTransparency    = 0.82
        hl.OutlineTransparency = 0.05
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled             = false
        hl.Parent              = char
        d.hl                   = hl

        local head = char:FindFirstChild("Head")
        if head then
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0,120,0,36)
            bb.StudsOffset = Vector3.new(0,2.5,0)
            bb.AlwaysOnTop = true
            bb.Parent = head
            d.bb = bb

            local nl = Instance.new("TextLabel")
            nl.Name = "NL"; nl.Size = UDim2.new(1,0,0.55,0)
            nl.BackgroundTransparency = 1
            nl.Font = Enum.Font.GothamBold; nl.TextSize = 12
            nl.TextStrokeTransparency = 0.3
            nl.Visible = false; nl.Parent = bb

            local dl = Instance.new("TextLabel")
            dl.Name = "DL"; dl.Size = UDim2.new(1,0,0.45,0)
            dl.Position = UDim2.new(0,0,0.55,0)
            dl.BackgroundTransparency = 1
            dl.Font = Enum.Font.Gotham; dl.TextSize = 10
            dl.TextStrokeTransparency = 0.4
            dl.Visible = false; dl.Parent = bb
        end

        local boxF = Instance.new("Frame")
        boxF.BackgroundTransparency = 1; boxF.BorderSizePixel = 0
        boxF.ZIndex = 10; boxF.Visible = false; boxF.Parent = SG
        d.box = boxF; d.bs = {}
        for i = 1,4 do
            local s = Instance.new("Frame")
            s.BorderSizePixel = 0; s.ZIndex = 10; s.Parent = boxF
            d.bs[i] = s
        end

        local hbf = Instance.new("Frame")
        hbf.BackgroundColor3 = Color3.fromRGB(10,10,10)
        hbf.BackgroundTransparency = 0.3; hbf.BorderSizePixel = 0
        hbf.ZIndex = 11; hbf.Visible = false; hbf.Parent = SG
        d.hbf = hbf
        local hbFill = Instance.new("Frame")
        hbFill.BorderSizePixel = 0; hbFill.ZIndex = 12; hbFill.Parent = hbf
        d.hbFill = hbFill

        task.spawn(function()
            while ST.ESPData[p] == d and char.Parent and CFG.ESPOn do
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local myR  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not root or not hum then task.wait(0.05); continue end

                local hide = CFG.TeamESP and isTeam(p)
                local col  = eCol(p)
                if ST.Target and ST.Target.player == p then col = C.YELLOW end
                if hum.Health <= 0 then col = C.RED end

                d.hl.Enabled = CFG.ChamsOn and not hide
                d.hl.OutlineColor = col; d.hl.FillColor = col

                if d.bb then
                    local nl = d.bb:FindFirstChild("NL")
                    local dl = d.bb:FindFirstChild("DL")
                    if nl then nl.Text = p.Name; nl.TextColor3 = col; nl.Visible = CFG.NameOn and not hide end
                    if dl then
                        dl.Visible = CFG.DistOn and not hide
                        if CFG.DistOn and myR and not hide then
                            dl.Text = math.floor((root.Position - myR.Position).Magnitude).."m"
                            dl.TextColor3 = col
                        end
                    end
                end

                local pts = {"Head","UpperTorso","LowerTorso","LeftHand","RightHand","LeftFoot","RightFoot"}
                local mnX,mnY,mxX,mxY = math.huge,math.huge,-math.huge,-math.huge
                local allOn = true
                for _, pn in ipairs(pts) do
                    local pp = char:FindFirstChild(pn)
                    if pp then
                        local sp2, on2 = CAM:WorldToViewportPoint(pp.Position)
                        if not on2 then allOn = false; break end
                        if sp2.X<mnX then mnX=sp2.X end; if sp2.Y<mnY then mnY=sp2.Y end
                        if sp2.X>mxX then mxX=sp2.X end; if sp2.Y>mxY then mxY=sp2.Y end
                    end
                end

                local showBox = CFG.BoxOn and allOn and not hide
                d.box.Visible = showBox
                if showBox then
                    local pad,t2 = 3,1.5
                    d.box.Position = UDim2.new(0,mnX-pad,0,mnY-pad)
                    d.box.Size     = UDim2.new(0,(mxX-mnX)+pad*2,0,(mxY-mnY)+pad*2)
                    local s = d.bs
                    s[1].Position=UDim2.new(0,0,0,0);   s[1].Size=UDim2.new(1,0,0,t2); s[1].BackgroundColor3=col
                    s[2].Position=UDim2.new(0,0,1,-t2); s[2].Size=UDim2.new(1,0,0,t2); s[2].BackgroundColor3=col
                    s[3].Position=UDim2.new(0,0,0,0);   s[3].Size=UDim2.new(0,t2,1,0); s[3].BackgroundColor3=col
                    s[4].Position=UDim2.new(1,-t2,0,0); s[4].Size=UDim2.new(0,t2,1,0); s[4].BackgroundColor3=col
                end

                local showHP = CFG.HealthOn and allOn and not hide
                d.hbf.Visible = showHP
                if showHP then
                    local hp = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
                    d.hbf.Position = UDim2.new(0,mnX-7,0,mnY)
                    d.hbf.Size     = UDim2.new(0,4,0,mxY-mnY)
                    d.hbFill.Size  = UDim2.new(1,0,hp,0)
                    d.hbFill.Position = UDim2.new(0,0,1-hp,0)
                    d.hbFill.BackgroundColor3 = Color3.fromHSV(hp*0.33,1,1)
                end

                task.wait(0)
            end
            ESP.remove(p)
        end)
    end

    if p.Character then build(p.Character) end
    p.CharacterAdded:Connect(build)
end

function ESP.enable()
    ESP.disable()
    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP then ESP.add(p) end
    end
    PL.PlayerAdded:Connect(function(p)
        if p ~= LP and CFG.ESPOn then ESP.add(p) end
    end)
    PL.PlayerRemoving:Connect(ESP.remove)
end

function ESP.disable()
    for p in pairs(ST.ESPData) do ESP.remove(p) end
end

-- ══════════════════════════════════════
--  GUI HELPERS
-- ══════════════════════════════════════
local function crn(o, r)
    Instance.new("UICorner", o).CornerRadius = r or UDim.new(0,5)
end

local function tw(o, p, t)
    TS:Create(o, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quart), p):Play()
end

-- Label
local function lbl(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel        = 0
    l.Text                   = props.text   or ""
    l.TextColor3             = props.color  or C.TEXT
    l.Font                   = props.font   or Enum.Font.GothamMedium
    l.TextSize               = props.size   or 11
    l.TextXAlignment         = props.align  or Enum.TextXAlignment.Center
    l.Size                   = props.sz     or UDim2.new(1,0,1,0)
    l.Position               = props.pos    or UDim2.new(0,0,0,0)
    l.TextWrapped            = props.wrap   or false
    l.Parent                 = parent
    return l
end

-- ══════════════════════════════════════
--  SWITCH  (fix mobile)
-- ══════════════════════════════════════
local function mkSwitch(parent, init, cb)
    -- Container que preenche a area de toque
    local area = Instance.new("Frame")
    area.Size             = UDim2.new(0, 60, 1, 0)  -- área de toque grande
    area.BackgroundTransparency = 1
    area.BorderSizePixel  = 0
    area.AnchorPoint      = Vector2.new(1, 0.5)
    area.Position         = UDim2.new(1, -4, 0.5, 0)
    area.Parent           = parent

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(0, 36, 0, 18)
    track.AnchorPoint      = Vector2.new(0.5, 0.5)
    track.Position         = UDim2.new(0.5, 0, 0.5, 0)
    track.BackgroundColor3 = init and C.ON or C.OFF
    track.BorderSizePixel  = 0
    track.Parent           = area
    crn(track, UDim.new(1,0))

    local thumb = Instance.new("Frame")
    thumb.Size             = UDim2.new(0, 12, 0, 12)
    thumb.AnchorPoint      = Vector2.new(0.5, 0.5)
    thumb.Position         = init
        and UDim2.new(0, 27, 0.5, 0)
        or  UDim2.new(0, 9,  0.5, 0)
    thumb.BackgroundColor3 = init
        and Color3.fromRGB(190,140,255)
        or  Color3.fromRGB(80,80,100)
    thumb.BorderSizePixel  = 0
    thumb.Parent           = track
    crn(thumb, UDim.new(1,0))

    local on = init or false

    local function set(v)
        on = v
        tw(track, {BackgroundColor3 = on and C.ON or C.OFF})
        tw(thumb, {
            Position         = on and UDim2.new(0,27,0.5,0) or UDim2.new(0,9,0.5,0),
            BackgroundColor3 = on and Color3.fromRGB(190,140,255) or Color3.fromRGB(80,80,100),
        })
        if cb then cb(on) end
    end

    -- Botão transparente cobre TODA a area
    local hit = Instance.new("TextButton")
    hit.Size                 = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.BorderSizePixel      = 0
    hit.Text                 = ""
    hit.ZIndex               = 10
    hit.Parent               = area

    -- Conecta clique normal e touch
    local function toggle() set(not on) end
    hit.MouseButton1Click:Connect(toggle)
    hit.Activated:Connect(toggle)  -- funciona no mobile também

    return area, set
end

