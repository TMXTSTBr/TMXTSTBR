local function mkMaster(parent, label, order, onFn, offFn)
    local btn=Instance.new("ImageButton")
    btn.Size=UDim2.new(0,PW-10,0,26)
    btn.BackgroundColor3=Color3.fromRGB(14,14,18)
    btn.BorderSizePixel=0; btn.Image=""
    btn.LayoutOrder=order; btn.Parent=parent
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)
    local stk=Instance.new("UIStroke")
    stk.Color=BL; stk.Thickness=1; stk.Transparency=0.3; stk.Parent=btn

    local tl=Instance.new("TextLabel")
    tl.Size=UDim2.new(1,0,1,0); tl.BackgroundTransparency=1; tl.BorderSizePixel=0
    tl.Text=label.." · OFF"; tl.TextColor3=WD
    tl.Font=Enum.Font.GothamBlack; tl.TextSize=11; tl.Parent=btn

    local isOn=false
    local function toggle()
        isOn=not isOn
        if isOn then
            TS:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(28,28,34)}):Play()
            stk.Color=W; tl.TextColor3=W; tl.Text=label.." · ON"
            if onFn then onFn() end
        else
            TS:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=Color3.fromRGB(14,14,18)}):Play()
            stk.Color=BL; tl.TextColor3=WD; tl.Text=label.." · OFF"
            if offFn then offFn() end
        end
    end
    btn.MouseButton1Click:Connect(toggle)
    btn.Activated:Connect(toggle)
    return btn
end

