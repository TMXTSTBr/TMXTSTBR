-- ══════════════════════════════════════
--  UTILS
-- ══════════════════════════════════════
local function isAlive(c)
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function isTeam(p)
    if not CFG.TeamCheck then return false end
    return LP.Team and p.Team and LP.Team == p.Team
end

-- FPS
local lt = tick()
RS.Heartbeat:Connect(function()
    local n = tick()
    table.insert(ST.FB, 1/math.max(n-lt, 0.001))
    lt = n
    if #ST.FB > 20 then table.remove(ST.FB, 1) end
    local s = 0; for _, v in ipairs(ST.FB) do s += v end
    ST.FPS = math.floor(s/#ST.FB)
end)

-- ══════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════
local function getTarget()
    local best, bestD = nil, CFG.FOV
    local center = CAM.ViewportSize/2
    for _, p in ipairs(PL:GetPlayers()) do
        if p == LP or isTeam(p) then continue end
        local c = p.Character
        if not isAlive(c) then continue end
        local part = c:FindFirstChild(CFG.Part)
            or c:FindFirstChild("UpperTorso")
            or c:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local sp, on = CAM:WorldToViewportPoint(part.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y)-center).Magnitude
        if d >= bestD then continue end
        best = {part=part, char=c, player=p}; bestD = d
    end
    return best
end

local function aimLoop()
    if not CFG.AimOn then ST.Target=nil; ST.Locked=false; return end
    local t = getTarget()
    ST.Target=t; ST.Locked=t~=nil
    if t then
        CAM.CFrame = CAM.CFrame:Lerp(
            CFrame.new(CAM.CFrame.Position, t.part.Position), 1-CFG.Smooth)
    end
end

-- ══════════════════════════════════════
--  RECOIL
-- ══════════════════════════════════════
UIS.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.UserInputType==Enum.UserInputType.MouseButton1
    or i.UserInputType==Enum.UserInputType.Touch then ST.Shooting=true end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1
    or i.UserInputType==Enum.UserInputType.Touch then ST.Shooting=false end
end)

local function startRecoil()
    if ST.RConn then ST.RConn:Disconnect() end
    ST.RConn = RS.RenderStepped:Connect(function()
        if CFG.RecoilOn and ST.Shooting then
            CAM.CFrame = CAM.CFrame * CFrame.fromEulerAnglesXYZ(-math.rad(CFG.RecoilY*0.016),0,0)
        end
    end)
end
local function stopRecoil()
    if ST.RConn then ST.RConn:Disconnect(); ST.RConn=nil end
end

-- ══════════════════════════════════════
--  FPS BOOST
-- ══════════════════════════════════════
local orig = {}
local function applyBoost()
    orig.sh=LT.GlobalShadows; orig.br=LT.Brightness
    LT.GlobalShadows=false; LT.Brightness=1
    pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Level03 end)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ParticleEmitter") or o:IsA("Trail") then
            pcall(function() o.Enabled=false end)
        end
    end
end
local function removeBoost()
    pcall(function()
        LT.GlobalShadows=orig.sh~=nil and orig.sh or true
        LT.Brightness=orig.br or 1
        settings().Rendering.QualityLevel=Enum.QualityLevel.Level10
    end)
    for _,o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ParticleEmitter") or o:IsA("Trail") then
            pcall(function() o.Enabled=true end)
        end
    end
end

