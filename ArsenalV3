    fill.Size=UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3=W; fill.BorderSizePixel=0; fill.Parent=track
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)

    local knob=Instance.new("Frame")
    knob.Size=UDim2.new(0,11,0,11); knob.AnchorPoint=Vector2.new(0.5,0.5)
    knob.Position=UDim2.new((default-min)/(max-min),0,0.5,0)
    knob.BackgroundColor3=W; knob.BorderSizePixel=0; knob.ZIndex=3; knob.Parent=track
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)

    local val=default; local drag=false

    local function upd(v)
        v=math.clamp(math.floor(v),min,max); val=v
        local r=(v-min)/(max-min)
        fill.Size=UDim2.new(r,0,1,0); knob.Position=UDim2.new(r,0,0.5,0)
        vb.Text=tostring(v); if cb then cb(v) end
    end
    local function fromX(x)
        local r=math.clamp((x-track.AbsolutePosition.X)/math.max(track.AbsoluteSize.X,1),0,1)
        upd(min+r*(max-min))
    end

    -- Área de toque maior
    local tHit=Instance.new("ImageButton")
    tHit.Size=UDim2.new(1,0,0,20); tHit.Position=UDim2.new(0,0,0.5,-10)
    tHit.BackgroundTransparency=1; tHit.BorderSizePixel=0
    tHit.Image=""; tHit.ZIndex=5; tHit.Parent=track

    tHit.MouseButton1Click:Connect(function() end)

    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true; fromX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseMovement then fromX(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
    vb.FocusLost:Connect(function()
        local n=tonumber(vb.Text); if n then upd(n) else vb.Text=tostring(val) end
    end)
    return wrap
end

-- Seção
local function mkSec(parent, text, order)
    local f=Instance.new("Frame")
    f.Size=UDim2.new(0,PW-10,0,14); f.BackgroundTransparency=1
    f.LayoutOrder=order; f.Parent=parent
    local l=Instance.new("TextLabel")
    l.Size=UDim2.new(1,0,1,0); l.BackgroundTransparency=1; l.BorderSizePixel=0
    l.Text=text; l.TextColor3=WD; l.Font=Enum.Font.GothamBold; l.TextSize=9
    l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=f
end

-- Sep
local function mkSep(parent, order)
    local f=Instance.new("Frame")
    f.Size=UDim2.new(0,PW-10,0,1); f.BackgroundColor3=BL
    f.BorderSizePixel=0; f.LayoutOrder=order; f.Parent=parent
end

-- Row switch com label
local function mkRow(parent, label, order, init, cb)
    local sw, txt, fn = mkSwitch(parent, init, cb)
    sw.LayoutOrder = order
    txt.Text = label
    return sw, fn
end

