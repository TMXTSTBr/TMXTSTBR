-- ══════════════════════════════════════
--  DRAG  (só header)
-- ══════════════════════════════════════
do
    local drag=false; local tid=nil; local si,sp

    -- posição base do monitor e scroll (relativa ao hdr)
    local MON_OFF_Y = HDR_H + 4
    local SCR_OFF_Y = HDR_H + MON_H + 8

    local function updateChildren()
        local px=hdr.Position.X.Offset
        local py=hdr.Position.Y.Offset
        monBar.Position=UDim2.new(0,px,0,py+MON_OFF_Y)
        scroll.Position=UDim2.new(0,px,0,py+SCR_OFF_Y+4)
    end

    hdr.InputBegan:Connect(function(inp)
        local lx=inp.Position.X - hdr.AbsolutePosition.X
        if lx >= PW-52 then return end  -- reserva seta

        if inp.UserInputType==Enum.UserInputType.Touch and not tid then
            tid=inp; drag=true
            si=Vector2.new(inp.Position.X,inp.Position.Y)
            sp=hdr.Position
        elseif inp.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true
            si=Vector2.new(inp.Position.X,inp.Position.Y)
            sp=hdr.Position
        end
    end)

    UIS.InputChanged:Connect(function(inp)
        if not drag then return end
        local pos
        if inp.UserInputType==Enum.UserInputType.Touch and inp==tid then
            pos=Vector2.new(inp.Position.X,inp.Position.Y)
        elseif inp.UserInputType==Enum.UserInputType.MouseMovement then
            pos=Vector2.new(inp.Position.X,inp.Position.Y)
        end
        if pos then
            local d=pos-si
            hdr.Position=UDim2.new(
                sp.X.Scale,sp.X.Offset+d.X,
                sp.Y.Scale,sp.Y.Offset+d.Y)
            updateChildren()
        end
    end)

    UIS.InputEnded:Connect(function(inp)
        if (inp.UserInputType==Enum.UserInputType.Touch and inp==tid)
        or inp.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=false; tid=nil
        end
    end)
end

