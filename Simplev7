-- ══════════════════════════════════════
--  DRAG TOUCH + MOUSE
-- ══════════════════════════════════════
do
    local dragging=false; local touchId=nil
    local startInput=nil; local startPos=nil

    local function beginDrag(pos)
        dragging=true; startInput=pos; startPos=panel.Position
    end
    local function moveDrag(pos)
        if not dragging then return end
        local d=pos-startInput
        panel.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,
            startPos.Y.Scale,startPos.Y.Offset+d.Y)
    end
    local function endDrag() dragging=false; touchId=nil end

    header.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch and not touchId then
            touchId=input; beginDrag(Vector2.new(input.Position.X,input.Position.Y))
        elseif input.UserInputType==Enum.UserInputType.MouseButton1 then
            beginDrag(Vector2.new(input.Position.X,input.Position.Y))
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch and input==touchId then
            moveDrag(Vector2.new(input.Position.X,input.Position.Y))
        elseif input.UserInputType==Enum.UserInputType.MouseMovement then
            moveDrag(Vector2.new(input.Position.X,input.Position.Y))
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if (input.UserInputType==Enum.UserInputType.Touch and input==touchId)
        or input.UserInputType==Enum.UserInputType.MouseButton1 then endDrag() end
    end)
end

