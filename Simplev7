-- Drag FAB
do
    local drag=false; local tid=nil; local si=nil; local sp2=nil; local moved=false
    fab.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.Touch and not tid then
            tid=input; drag=true; moved=false
            si=Vector2.new(input.Position.X,input.Position.Y); sp2=fab.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if drag and input==tid then
            local d=Vector2.new(input.Position.X,input.Position.Y)-si
            if d.Magnitude>5 then moved=true end
            fab.Position=UDim2.new(sp2.X.Scale,sp2.X.Offset+d.X,sp2.Y.Scale,sp2.Y.Offset+d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input==tid then
            drag=false; tid=nil
            if not moved then fab.Visible=false; openPanel() end
        end
    end)
end

