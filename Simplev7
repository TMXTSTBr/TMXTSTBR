-- ══════════════════════════════════════
--  FPS COUNTER
-- ══════════════════════════════════════
local fpsLabel -- declarado depois

local lastTick = tick()
RS.Heartbeat:Connect(function()
    local now  = tick()
    local dt   = now - lastTick
    lastTick   = now

    table.insert(ST.FPSList, 1/dt)
    if #ST.FPSList > 20 then table.remove(ST.FPSList) end

    local sum = 0
    for _, v in ipairs(ST.FPSList) do sum += v end
    ST.FPS = math.floor(sum / #ST.FPSList)

    if fpsLabel then
        local fps  = ST.FPS
        local col  = CFG.C_GREEN
        if fps < 30 then col = CFG.C_RED
        elseif fps < 50 then col = CFG.C_YELLOW end
        fpsLabel.Text      = "FPS: "..fps
        fpsLabel.TextColor3 = col
    end
end)

-- ══════════════════════════════════════
--  FPS BOOST
-- ══════════════════════════════════════
local FPSBoost = {}

-- Salvar estado original
local function saveEnv()
    ST.OrigEnv = {
        shadow         = LIGHT.GlobalShadows,
        brightness     = LIGHT.Brightness,
        fogEnd         = LIGHT.FogEnd,
        fogStart       = LIGHT.FogStart,
        quality        = settings().Rendering.QualityLevel,
        particles      = {},
        decals         = {},
        textures       = {},
        sounds         = {},
    }
    -- Partículas, decals, texturas
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") then
            ST.OrigEnv.particles[obj] = obj.Enabled
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            ST.OrigEnv.decals[obj] = obj.Transparency
        elseif obj:IsA("SpecialMesh") then
            ST.OrigEnv.textures[obj] = obj.TextureId
        end
    end
end

function FPSBoost.apply(level)
    saveEnv()

    -- Nível 1: Leve
    LIGHT.GlobalShadows = false
    LIGHT.Brightness    = 1
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level05

    if level >= 2 then
        -- Nível 2: Médio
        LIGHT.FogEnd   = 1000
        LIGHT.FogStart = 900

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") then
                obj.Enabled = false
            elseif obj:IsA("Decal") then
                obj.Transparency = 1
            end
        end

        settings().Rendering.QualityLevel = Enum.QualityLevel.Level03
    end

    if level >= 3 then
        -- Nível 3: Máximo
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("SpecialMesh") then
                obj.TextureId = ""
            elseif obj:IsA("Texture") then
                obj.Transparency = 1
            elseif obj:IsA("Sound") then
                obj.Volume = 0
            end
        end

        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01

        -- Remover sombras e reflexos
        LIGHT.GlobalShadows   = false
        LIGHT.EnvironmentDiffuseScale = 0
        LIGHT.EnvironmentSpecularScale = 0
    end

    -- FPS Cap
    settings().Rendering.FrameRateManager = Enum.FrameRateManagerMode.On
end

function FPSBoost.restore()
    pcall(function()
        LIGHT.GlobalShadows = ST.OrigEnv.shadow
        LIGHT.Brightness    = ST.OrigEnv.brightness
        LIGHT.FogEnd        = ST.OrigEnv.fogEnd
        LIGHT.FogStart      = ST.OrigEnv.fogStart
        LIGHT.EnvironmentDiffuseScale  = 1
        LIGHT.EnvironmentSpecularScale = 1
        settings().Rendering.QualityLevel = ST.OrigEnv.quality

        for obj, val in pairs(ST.OrigEnv.particles) do
            if obj and obj.Parent then obj.Enabled = val end
        end
        for obj, val in pairs(ST.OrigEnv.decals) do
            if obj and obj.Parent then obj.Transparency = val end
        end
        for obj, val in pairs(ST.OrigEnv.textures) do
            if obj and obj.Parent then obj.TextureId = val end
        end
    end)
end

-- ══════════════════════════════════════
--  ANTI-RECOIL
-- ══════════════════════════════════════
-- Detecta tiro por botão do mouse / toque
-- e compensa movendo a câmera

local recoilConn

local function startRecoil()
    if recoilConn then recoilConn:Disconnect() end
    recoilConn = RS.RenderStepped:Connect(function()
        if not CFG.RecoilOn then return end
        if not ST.Shooting    then return end

        local rx = math.rad(CFG.RecoilY * 0.016)
        local ry = math.rad(CFG.RecoilX * 0.016)

        CAM.CFrame = CAM.CFrame
            * CFrame.fromEulerAnglesXYZ(-rx, ry, 0)
    end)
end

local function stopRecoil()
    if recoilConn then recoilConn:Disconnect(); recoilConn = nil end
end

-- Detectar botão de tiro (Touch e Mouse)
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        ST.Shooting = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        ST.Shooting = false
    end
end)

-- ══════════════════════════════════════
--  UTILS
-- ══════════════════════════════════════
local function alive(char)
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function getVel(char)
    local r = char and char:FindFirstChild("HumanoidRootPart")
    return (r and r:IsA("BasePart")) and r.AssemblyLinearVelocity or Vector3.zero
end

local function shouldHit()
    if not CFG.LegitMode then return true end
    ST.HitTick += 1
    return (ST.HitTick % math.max(1, math.floor(100/CFG.HitChance))) == 0
end

local function wallOk(origin, pos, char)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Blacklist
    p.FilterDescendantsInstances = {LP.Character or {}}
    local r = workspace:Raycast(origin, pos-origin, p)
    if r then return r.Instance:FindFirstAncestorOfClass("Model") == char end
    return true
end

-- ══════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════
local function getTarget()
    local best, bestD = nil, CFG.FOV
    local center = CAM.ViewportSize/2

    for _, p in ipairs(PL:GetPlayers()) do
        if p == LP then continue end
        local c = p.Character
        if not alive(c) then continue end

        local part = c:FindFirstChild(CFG.Part) or c:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local tpos = part.Position

        -- Compensar bullet drop
        if CFG.DropOn then
            tpos = tpos + Vector3.new(0, CFG.DropAmount * 0.1, 0)
        end

        if CFG.Predict then
            tpos = tpos + getVel(c) * CFG.PredMult
        end

        local sp, on = CAM:WorldToViewportPoint(tpos)
        if not on then continue end

        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d >= bestD then continue end

        if CFG.WallCheck and not wallOk(CAM.CFrame.Position, tpos, c) then continue end

        best  = {part=part, char=c, player=p, pos=tpos}
        bestD = d
    end
    return best
end

local function aimUpdate()
    if not CFG.AimOn then ST.Target=nil; ST.Locked=false; return end
    if CFG.ScopeOnly and CAM.FieldOfView >= 50 then return end
    if not shouldHit() then return end

    local t = getTarget()
    ST.Target = t
    ST.Locked = t ~= nil

    if t then
        local goal = CFrame.new(CAM.CFrame.Position, t.pos)
        CAM.CFrame = CAM.CFrame:Lerp(goal, 1-CFG.Smooth)
    end
end

